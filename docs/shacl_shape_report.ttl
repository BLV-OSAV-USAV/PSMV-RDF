_:N44005fa8004f4c70a88c95f9816ff976 rdf:first country:CHE ;
    rdf:rest ( country:DEU country:ITA country:FRA country:AUT country:BEL ) .

_:nc73ffb5ca1414bb798aceca41957b4e4b67 sh:datatype xsd:string ;
    sh:description "An identifier assigned by the FSVO that uniquely identifies an admissions of a plant protection product."@en ;
    sh:maxCount 1 ;
    sh:message "The federal admission number must match the pattern 'L-DDDD' or 'L-DDDD-D', where L is an uppercase letter and D a digit."@en ;
    sh:minCount 1 ;
    sh:name "Federal admission number"@en ;
    sh:path :federalAdmissionNumber ;
    sh:pattern "^[A-Z]-[0-9]{4}(-[0-9]{1,2})?$" .

_:nc73ffb5ca1414bb798aceca41957b4e4b66 sh:datatype xsd:string ;
    sh:description "An identifier assigned by the FSVO that uniquely identifies an admissions of a plant protection product."@en ;
    sh:maxCount 1 ;
    sh:message "The federal admission number must match the pattern 'L-DDDD' or 'L-DDDD-D', where L is an uppercase letter and D a digit."@en ;
    sh:minCount 1 ;
    sh:name "Federal admission number"@en ;
    sh:path :federalAdmissionNumber ;
    sh:pattern "^[A-Z]-[0-9]{1,4}(-[0-9]{1,2})?$" .

_:nc73ffb5ca1414bb798aceca41957b4e4b47 sh:datatype xsd:string ;
    sh:description "Name of the product"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Name"@en ;
    sh:order 1 ;
    sh:path schema:name .

_:nc73ffb5ca1414bb798aceca41957b4e4b54 sh:description "The country where a plant protection product was produced."@en ;
    sh:in _:N44005fa8004f4c70a88c95f9816ff976 ;
