    sh:minCount 1 ;
    sh:name "Producing country"@en ;
    sh:order 9 ;
    sh:path schema:countryOfOrigin .

_:nc73ffb5ca1414bb798aceca41957b4e4b80 schema:name "Federal admission number syntax"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "The federal admission number must match the pattern 'L-DDDD' or 'L-DDDD-D', where L is an uppercase letter and D a digit."@en ;
    sh:minCount 1 ;
    sh:path :federalAdmissionNumber ;
    sh:pattern "^[A-Z]-[0-9]{1,4}(-[0-9]{1,2})?$" .

