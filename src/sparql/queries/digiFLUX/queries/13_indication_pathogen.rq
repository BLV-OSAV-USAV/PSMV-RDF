PREFIX : <https://agriculture.ld.admin.ch/plant-protection/>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT
  ?indication_id
  ?pathogen_id
  ?effect
  ?additional_text_de
  ?additional_text_en
  ?additional_text_fr
  ?additional_text_it
FROM <https://lindas.admin.ch/fsvo/plant-protection-products>
WHERE {
  VALUES ?effectProp { :fullEffect :partialEffect :sideEffect }
  ?indication a :Indication ;
    schema:identifier ?indication_id ;
    :product / a :Product ;
    ?effectProp ?pest .
  BIND(REPLACE(STR(?pest), "^.*/", "") AS ?pathogen_id)
  BIND(REPLACE(STR(?effectProp), "^.*[/#]", "") AS ?localName)
  BIND(
    UCASE(
      REPLACE(
        REPLACE(?localName, "([a-z0-9])([A-Z])", "$1_$2"),
        "([A-Z])([A-Z][a-z])", "$1_$2"
      )
    ) AS ?effect
  )
  OPTIONAL {
    ?indication :pestWithAdditionalText ?pw .
    ?pw :pest ?pest ; :additionalText ?text .
    OPTIONAL { ?text schema:name ?additional_text_de FILTER(LANG(?additional_text_de) = "de") }
    OPTIONAL { ?text schema:name ?additional_text_en FILTER(LANG(?additional_text_en) = "en") }
    OPTIONAL { ?text schema:name ?additional_text_fr FILTER(LANG(?additional_text_fr) = "fr") }
    OPTIONAL { ?text schema:name ?additional_text_it FILTER(LANG(?additional_text_it) = "it") }
  }
}
ORDER BY ?indication_id ?pathogen_id
