    schema:identifier "9461" .

code:AF6AED43-821F-4A47-B4FE-799A27038B97 a :Obligation ;
    schema:description "Vorsicht: Resistenzgefahr! Produkt im Wechsel mit Produkten anderer Wirkstoffgruppen einsetzen."@de,
        "Attention: risque de résistance! Utiliser produit en alternance avec des produits des autres groupes de substances actives."@fr,
        "Attenzione: rischio di resistenza! Impiegare prodotto in alternanza con prodotti di altri gruppi di principi attivi."@it ;
    schema:identifier "9137" .

code:AF74EFAF-E996-408D-8FDC-5C0674E80410 a :Obligation ;
    schema:description "Pflanzen allseitig gut benetzen. Behandlung nach Bedarf wiederholen."@de,
        "Bien mouiller les plantes de tous les côtés. Si nécessaire, répéter le traitement."@fr,
        "Bagnare le piante a pioggia da tutti i lati. Se necessario ripetere il trattamento."@it ;
    schema:identifier "8181" .

code:AFA1A857-2516-413F-97CA-48274002FCA5 a :Obligation ;
    schema:description "Mindestens 3 Behandlungen, Intervall: 7 bis 14 Tage."@de,
