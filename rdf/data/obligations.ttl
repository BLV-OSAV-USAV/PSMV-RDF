@prefix : <https://agriculture.ld.admin.ch/plant-protection/> .
@prefix code: <https://agriculture.ld.admin.ch/plant-protection/code/> .
@prefix schema: <http://schema.org/> .

code:000AB471-B6B6-4CE7-BBBB-7588C9677BB3 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 2 Behandlungen pro Kultur mit Produkten aus der Wirkstoffgruppe FRAC C3 (u.a. Strobilurine)."@de,
        "SPa 1: Pour éviter le développement de résistances, 2 traitements au maximum par culture avec des produits du groupe de matières actives FRAC C3 (notamment les strobilurines)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 2 trattamenti per coltura con prodotti del gruppo di principi attivi FRAC C3 (tra cui strobilurine)."@it ;
    schema:identifier "13708" .

code:00137EC0-92E2-4376-B3CD-630BF7840A09 a :Obligation ;
    schema:description "In Tankmischung gemäss den Angaben der Bewilligungsinhaberin."@de,
        "En mélange en cuve selon les indications du titulaire de l'autorisation."@fr,
        "Utilizzabile in una miscela estemporanea secondo le indicazioni del titolare dell'autorizzazione"@it ;
    schema:identifier "14080" .

code:00836A1F-6ADE-4B38-8727-3D794BD59828 a :Obligation ;
    schema:description "Erste Behandlung nach der Pflanzung, zweite Behandlung 3 Wochen später."@de,
        "Premier traitement après la plantation, deuxième traitement 3 semaines plus tard."@fr,
        "Primo trattamento subito dopo la piantagione, secondo trattamento dopo 3 settimane."@it ;
    schema:identifier "13792" .

code:00C27B5A-7923-4A59-9FFB-9D2957ADFC8D a :Obligation ;
    schema:description "Anwendung nur unter den Bäumen"@de,
        "Traitement seulement sous les arbres"@fr,
        "Trattamento esclusivamente sotto gli alberi"@it ;
    schema:identifier "14486" .

code:00E5D1C0-CC78-43FF-9629-83B2CE784AC0 a :Obligation ;
    schema:description "Bewilligt nur für die Behandlung leerer Räume mit rauher Oberfläche vor der Einlagerung folgender getrockneter Erntegüter: Getreide, Mais, Reis, Ackerbohnen, Bohnen, Eiweisserbsen, Linsen."@de,
        "Autorisé seulement pour le traitement des surfaces rugueuses des locaux vides avant le stockage des produits de récolte séchés suivants: céréales, maïs, riz, féveroles, haricots, pois protéagineux, lentilles."@fr,
        "Autorizzato esclusivamente per il trattamento dei locali vuoti con superfici rugose prima dell'immagazzinaggio dei seguenti prodotti sechi: cereali, mais, riso, fave, fagioli, piselli proteici, lenticchie."@it ;
    schema:identifier "9934" .

code:011A3E57-E9C3-4A43-B45B-D1472BA09AAD a :Obligation ;
    schema:description "2 x 3 l in je 300 l Spritzbrühe/ha. Kein Mineralölzusatz."@de,
        "2 x 3 l dans 300 l de bouillie/ha pour chaque traitement. Ne pas ajouter d'huile minérale."@fr,
        "2 x 3 l in 300 l di poltiglia per irrorazione/ha. Nessuna aggiunta di olio minerale."@it ;
    schema:identifier "8360" .

code:013F5F23-7A84-4D34-9DDB-9CDCC4A890F7 a :Obligation ;
    schema:description "Nur bei Befall (sichtbare Wirkung tritt erst nach 14 Tagen ein). Nachbehandlung, falls nötig, frühestens nach 3 Wochen."@de,
        "En cas d'attaque uniquement (l'efficacité ne devient visible qu'après 15 jours). Le cas échéant, effectuer un nouveau traitement au plus tôt trois semaines après."@fr,
        "Unicamente in caso di infestazione (l'efficacia è visibile soltanto dopo 14 giorni). Trattamento successivo, se necessario, al più presto dopo 3 settimane."@it ;
    schema:identifier "8710" .

code:0153133E-9EF0-40BC-B58F-3F2334A57E63 a :Obligation ;
    schema:description "Bei der Anwendung des Mittels Schutzhandschuhe tragen."@de,
        "Lors de l'application du produit porter des gants de protection."@fr,
        "Durante l'applicazione del prodotto indossare guanti di protezione."@it ;
    schema:identifier "14006" .

code:019E4BB1-6D1E-4553-8AC0-18B965064C04 a :Obligation ;
    schema:description "Bei der Anwendung des Mittels Schutzhandschuhe + mindestens langärmliges Hemd + lange Hosen + festes Schuhwerk tragen."@de,
        "Lors de l'application du produit, porter des gants de protection + au minimum une chemise à manches longues + des pantalons + des chaussures résistantes."@fr,
        "Durante l'applicazione del prodotto, indossare guanti di protezione + almeno una camicia a maniche lunghe + pantaloni lunghi + scarpe solide."@it ;
    schema:identifier "15180" .

code:01AB42E0-ABAB-4F58-9DD4-678B059706C8 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung darf dieses oder irgendein anderes Pflanzenschutzmittel, welches Fludioxonil enthält, nicht mehr als viermal pro Jahr ausgebracht werden."@de,
        "SPa 1: Pour éviter le développement de résistances, ne pas appliquer ce produit ou d'autres produits contenant fludioxonil plus de 4 fois par année et parcelle."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza applicare al massimo 4 trattamenti per anno e particella con questo prodotto o con altri prodotti contenenti fludioxonil."@it ;
    schema:identifier "13367" .

code:01BD3E5A-179F-4EF1-A91C-B703FCCD1CD1 a :Obligation ;
    schema:description "Blattbehandlung."@de,
        "traitement foliaire."@fr,
        "Trattamento fogliare."@it ;
    schema:identifier "9364" .

code:01C9F1DF-761A-483A-B801-60CC2E5986F6 a :Obligation ;
    schema:description "Maximal 10 Behandlungen pro Parzelle und Jahr."@de,
        "10 traitements par parcelle et par année au maximum."@fr,
        "Al massimo 10 trattamenti per anno e particella."@it ;
    schema:identifier "13434" .

code:01DFF473-587F-4676-B728-C7322A0F6239 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 2 Anwendungen in dieser Indikation. Pflanzenschutzmittel mit einem Wirkstoff der Gruppe der SDHI dürfen nicht mehr als 3 Mal und Pflanzenschutzmittel mit einem Wirkstoff der QoI (Quinone outside Inhibitors) dürfen nicht mehr als 4 Mal pro Jahr ausgebracht werden."@de,
        "SPa 1: Pour éviter le développement de résistances 2 traitements au maximum dans cette indication. Ne pas appliquer des produits contenant une matière active du groupe des SDHI plus de 3 fois et des produits contenant une matière active du groupe des QoI (Quinone outside Inhibitors) plus de 4 fois par année."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenze applicare al massimo 2 volte nell'indicazione. Non applicare prodotti contenenti un principio attivo del gruppo dei SDHI più di 3 volte all'anno e prodotti contenenti un principio attivo del gruppo dei QoI (Quinone outside Inhibitors) più di 4 volte all'anno."@it ;
    schema:identifier "12802" .

code:01E14749-B9DA-43D2-B2DE-B9025748A25E a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 2 Behandlungen pro Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr. 49 (oxysterol binding protein homologue inhibition, OSBPI)."@de,
        "SPa 1: Pour éviter le développement de résistances, 2 traitements au maximum par année avec des produits du groupe de matières actives FRAC N° 49 (oxysterol binding protein homologue inhibition, OSBPI)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 2 trattamenti per anno con prodotti del gruppo di principi attivi FRAC numero 49 (oxysterol binding protein homologue inhibition, OSBPI)."@it ;
    schema:identifier "15943" .

code:01EC1789-053B-4A99-A7BE-4837137C7CF3 a :Obligation ;
    schema:description "2 Behandlungen pro Parzelle und Jahr im Abstand von 10 Tagen."@de,
        "2 traitements par parcelle et par année avec un intervalle de 10 jours."@fr,
        "2 trattamenti per particella e per anno ad un intervallo di 10 giorni"@it ;
    schema:identifier "13581" .

code:01F96372-E4E9-4D9C-8973-581E516F065B a :Obligation ;
    schema:description "Veränderungen des Geschmacks von behandelten Zwiebeln sind nicht auszuschliessen."@de,
        "Il n'est pas exclu que le traitement entraîne une modification du goût des oignons traités."@fr,
        "Non sono da escludere alterazioni del gusto delle cipolle trattate."@it ;
    schema:identifier "11724" .

code:01F9ACD8-DA77-4E83-8600-C33CB299E3B8 a :Obligation ;
    schema:description "Maximal 4 Behandlungen pro Kultur."@de,
        "4 traitements au maximum par culture."@fr,
        "Al massimo 4 trattamenti per coltura."@it ;
    schema:identifier "9871" .

code:0200FADC-5EE6-4160-8B33-CD41250A3410 a :Obligation ;
    schema:description "Beim Ansetzen der Spritzbrühe und beim Umgang mit behandeltem Lagergut sind Schutzhandschuhe zu tragen."@de,
        "Lors de la préparation de la bouillie de pulvérisation et lors de la manipulation de marchandise traitée, stockée, porter des gants de protection."@fr,
        "Durante la preparazione della poltiglia e nel manipolare merci depositate trattate è necessario indossare guanti di protezione."@it ;
    schema:identifier "12389" .

code:0216EC5C-4E52-4756-A812-48857CFFCFF4 a :Obligation ;
    schema:description "Herbst: maximal 1 Behandlung pro Parzelle."@de,
        "Automne: 1 traitement par parcelle au maximum."@fr,
        "Autunno: Al massimo 1 trattamento per particella."@it ;
    schema:identifier "14252" .

code:0235A1D0-1EB9-4681-BC67-253144504B13 a :Obligation ;
    schema:description "Diese Tankmischung lässt weitere Mischungspartner zu."@de,
        "Ce mélange permet l'adjonction d'autres produits."@fr,
        "Questa combinazione permette l'aggiunta di altri prodotti."@it ;
    schema:identifier "11417" .

code:023B4FAD-2887-4118-B113-B4EDB4B95EB9 a :Obligation ;
    schema:description "Gemäss Chemikalien-Risikoreduktions-Verordnung (ChemRRV, Anhang 2.5): Nur Einzelpflanzenbehandlung anderweitig nicht bekämpfbarer Problempflanzen bei National- und Kantonsstrassen."@de,
        "Conformément à l'ordonnance sur la réduction des risques liés aux produits chimiques (ORRChim, annexe 2.5) : Seulement traitement plante par plante de végétaux posant des problèmes se trouvant le long des routes nationales et cantonales et s'il est impossible de les combattre par d'autres mesures."@fr,
        "Conformemente all'ordinanza sulla riduzione dei rischi inerenti ai prodotti chimici (ORRPChim, allegato 2.5): Soltanto trattamenti pianta per pianta su piante problematiche lungo le strade nazionali e cantonali, sempre che non possono essere combattute con altre misure."@it ;
    schema:identifier "9353" .

code:029C0EA5-E7A2-4D4B-A786-718173BA8499 a :Obligation ;
    schema:description "Leeres Gebinde gründlich reinigen und zur Kehrichtabfuhr."@de,
        "Les récipients vides doivent être nettoyés soigneusement et confiés à la voirie en vue de leur élimination."@fr,
        "Pulire accuratamente il contenitore vuoto e smaltire con la spazzatura."@it ;
    schema:identifier "14178" .

code:02BC902B-48E9-4C6C-BB37-42E388A27311 a :Obligation ;
    schema:description "Maximal 3 Behandlungen pro Kultur mit diesem Produkt oder einem anderen Produkt, das den Wirkstoff Tebuconazole enthält."@de,
        "3 traitements au maximum par culture avec ce produit ou tout autre produit contenant la substance active tebuconazole."@fr,
        "Al massimo 3 trattamenti per coltura con questo prodotto o qualsiasi altro prodotto contenente la sostanza attiva tebuconazolo."@it ;
    schema:identifier "12908" .

code:02DE8CF1-DE3A-4929-8253-99688F819F41 a :Obligation ;
    schema:description "Behandlungen im Abstand von mindestens 7-10 Tagen."@de,
        "Traitements avec un intervalle d'au moins 7-10 jours."@fr,
        "Trattamenti con un intervallo di almeno 7-10 giorni."@it ;
    schema:identifier "13437" .

code:02E07B15-D2C8-4CF7-908D-052FBCFDDF93 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 4 Behandlungen pro Parzelle und Jahr mit Produkten aus derselben Wirkstoffgruppe."@de,
        "SPa 1: Pour éviter le développement de résistances 4 traitements au maximum par parcelle et par année avec des produits du même groupe de matières actives."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 4 trattamenti per anno e particella con prodotti dello stesso gruppo di principi attivi."@it ;
    schema:identifier "9590" .

code:02E9F67E-02C4-42A7-A619-3C51713DC1BD a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 3 Behandlungen pro Parzelle und Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr.11 (Strobilurine, QoI-Hemmer)."@de,
        "SPa 1: Pour éviter le développement de résistances, 3 traitements au maximum par parcelle et par année avec des produits du groupe de matières actives FRAC N° 11 (Strobilurines et mode d'action analogue, Qol-inhibiteur)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 3 trattamenti per anno e particella con prodotti del gruppo di principi attivi FRAC numero 11 (Strobilurine e prodotti ad azione analoga, inibitori-Qol)."@it ;
    schema:identifier "14420" .

code:02EBD711-05CD-4416-AF5A-BB6E7072F961 a :Obligation ;
    schema:description "Zum Schutz von wildlebenden Säugern und Vögeln das Produkt nicht in Häufchen auslegen. Verschüttetes Produkt sofort zusammenkehren und entfernen."@de,
        "Pour protéger les oiseaux et les mammifères sauvages, ne pas disposer le produit en petits tas. Récupérer tout produit accidentellement répandu."@fr,
        "Per la protezione dei mammiferi e degli uccelli selvatici non spargere il prodotto a mucchietti. Togliere e recuperare immediatamente il prodotto accidentalmente fuoriuscito."@it ;
    schema:identifier "13281" .

code:032A04EB-CE97-4B9F-BB6D-4E8583D69A3A a :Obligation ;
    schema:description "In Tankmischung mit 1.5 l/ha Bultisan S."@de,
        "En mélange avec 1.5 l/ha Bultisan S."@fr,
        "In combinazione con 1.5 l/ha Bultisan S."@it ;
    schema:identifier "11371" .

code:03A46DCC-41DD-42F5-A411-54C1706D2D90 a :Obligation ;
    schema:description "Bewilligt nur für die Behandlung folgender getrockneter Erntegüter: Getreide, Mais, Reis, Ackerbohnen, Bohnen, Eiweisserbsen, Linsen."@de,
        "Autorisé seulement pour le traitement des produits récoltés séchés suivantes: céréales, maïs, riz, féveroles, haricots, pois protéagineux, lentilles."@fr,
        "Autorizzato esclusivamente per il trattamento dei seguenti prodotti sechhi: cereali, mais, riso, fave, fagioli, piselli proteici, lenticchie."@it ;
    schema:identifier "9916" .

code:03B3400C-5F42-4B4B-B77F-99330F82ACF4 a :Obligation ;
    schema:description "Freisetzung in Bereichen, wo Drosophila suzukii vorhanden ist, sowohl in den Anbauflächen als auch an deren Rändern. Die Zone für die Freisetzung muss relativ gross sein (flächendeckendes Management, Mindestfläche 1 ha)."@de,
        "Lâcher dans les zones où Drosophila suzukii est présente, à la fois dans les parcelles cultivées et sur les leurs bordures. La zone de lâcher doit être relativement grande (gestion sur toute la surface, surface minimale de 1 ha)"@fr,
        "Rilascio in aree in cui è presente Drosophila suzukii, sia nelle aree coltivate che ai loro margini. La zona di rilascio deve essere relativamente ampia (gestione dell'area, area minima 1 ha)"@it ;
    schema:identifier "15646" .

code:03B9F92C-3160-4C0E-997D-16348CCEF751 a :Obligation ;
    schema:description "Maximal 3 Behandlungen gegen Drosophila suzukii während des Stadiums 83-89 (BBCH)."@de,
        "3 traitements au maximum contre Drosophila suzukii pendant le stade 83-89 (BBCH)."@fr,
        "Al massimo 3 trattamenti contro la Drosophila suzukii durante lo stadio 83-89 (BBCH)."@it ;
    schema:identifier "13914" .

code:03FB7956-F44A-4324-BF1B-AC6A98D0912D a :Obligation ;
    schema:description "Bei der Anwendung des Mittels Schutzhandschuhe + Schutzbrille tragen."@de,
        "Lors de l'application du produit, porter des gants de protection + des lunettes de protection."@fr,
        "Durante l'applicazione del prodotto, indossare guanti di protezione + occhiali di protezione."@it ;
    schema:identifier "13891" .

code:041A712E-FC7B-49D3-B00C-1851AB423FE0 a :Obligation ;
    schema:description "Splitbehandlungen möglich."@de,
        "Il est possible de fractionner le traitement."@fr,
        "È possibile effettuare un trattamento frazionato."@it ;
    schema:identifier "14447" .

code:04281284-7C4F-4875-A466-EFE7A4E8C7AC a :Obligation ;
    schema:description "1-2 Behandlungen pro Kultur und Jahr."@de,
        "1-2 traitements par culture et par année."@fr,
        "1-2 trattamenti per coltura e anno."@it ;
    schema:identifier "9692" .

code:042BE397-BE0A-47A3-A0FE-2776C73C7A1C a :Obligation ;
    schema:description "2 Anwendungen."@de,
        "2 applications."@fr,
        "2 applicazioni."@it ;
    schema:identifier "9349" .

code:042EEFE4-6DC7-4455-9933-79EA3986481D a :Obligation ;
    schema:description "SPe 8: Gefährlich für Bienen - Darf nicht mit blühenden oder Honigtau aufweisenden Pflanzen in Kontakt kommen. Blühende Einsaaten oder Unkräuter vor der Behandlung entfernen (mähen oder mulchen)."@de,
        "SPe 8: Dangereux pour les abeilles - Ne doit pas entrer en contact avec des plantes en fleur ou exsudant du miellat. Les plantes d'enherbement et les adventices en fleurs doivent être éliminées avant le traitement (faucher ou broyer)."@fr,
        "SPe 8: Pericoloso per le api - Non deve entrare in contatto con piante in fiore o che presentano melata. Prima del trattamento eliminare colture intercalari o malerbe in fiore (sfalcio o pacciamatura)."@it ;
    schema:identifier "13843" .

code:044EE10B-46D0-4A86-A62F-CE58FFCF05CB a :Obligation ;
    schema:description "2-3 Anwendungen im Abstand von 3-5 Tagen (bei Bedarf)."@de,
        "2-3 applications à 3-5 jours d'intervalle (si nécessaire)"@fr,
        "2-3 applicazioni a intervalli di 3-5 giorni (se necessario)."@it ;
    schema:identifier "15625" .

code:0466783B-8D43-410B-8EB4-03138E2417FC a :Obligation ;
    schema:description "Maximale Aufwandmenge: 1.25 l/ha."@de,
        "Dosage maximale: 1.25 l/ha."@fr,
        "Dose massima: 1.25 l/ha."@it ;
    schema:identifier "12967" .

code:048EE2CB-FE72-4599-935C-565BCA4EFA8E a :Obligation ;
    schema:description "Sicherstellen, dass der behandelte Rasen bis zum nächsten Schnitt (inklusive Entfernung Schnittgut) nur mit langärmeligen Hemd + langen Hosen + festem Schuhwerk betreten wird."@de,
        "S'assurer que toute personne qui - jusqu'à la prochaine coupe, y compris l'élimination de l'herbe coupée - entre dans la pelouse traitée, porte une chemise à manches longues + un pantalon long + des chaussures résistantes."@fr,
        "Assicurarsi che qualsiasi persona che - fino al taglio successivo, compresa la rimozione dei tagli - entri in un prato trattato, indossi una camicia a maniche lunghe + pantaloni lunghi + scarpe solide."@it ;
    schema:identifier "15178" .

code:04B00AA2-537A-41F5-998B-D34C7A6FF9A1 a :Obligation ;
    schema:description "In 200 - 600 L Wasser/ha."@de,
        "Dans 200 à 600 l d'eau/ha."@fr,
        "In 200 - 600 l di acqua/ha."@it ;
    schema:identifier "14194" .

code:04DD3E13-F85C-4BB1-A471-1DA0BB940621 a :Obligation ;
    schema:description "Kernobst ab 1. Standjahr, Steinobst ab 2. Standjahr"@de,
        "Fruits à pépins: dès la première année de culture. Fruits à noyaux: dès la deuxième année de culture."@fr,
        "Frutta a granelli: dal 1° anno di coltura. Frutta a nocciolo: dal 2° anno di coltura."@it ;
    schema:identifier "15463" .

code:04F89B83-53AE-47D8-9193-95B096158AEA a :Obligation ;
    schema:description "Feltiella acarisuga ist ein Ergänzungs-Nützling zu anderen Nützlingen."@de,
        "Feltiella acarisuga s'utilise en complément avec d'autres organismes utiles (ou auxiliaires)."@fr,
        "Feltiella acarisuga è un ausiliare complementare."@it ;
    schema:identifier "9222" .

code:050AF555-0940-435B-96FF-2478A2B5085D a :Obligation ;
    schema:description "In Tankmischung mit 0.5 l/ha Condoral 70 WG."@de,
        "En mélange avec 0.5 l/ha Condoral 70 WG."@fr,
        "In combinazione con 0.5 l/ha Condoral 70 WG."@it ;
    schema:identifier "11372" .

code:053E4C31-99BC-47C7-9640-6C4E67538B00 a :Obligation ;
    schema:description "Einsatz in Kombination mit 'Aphipar'."@de,
        "Utilisation combinée avec de l'Aphipar."@fr,
        "Intervento in combinazione con Aphipar."@it ;
    schema:identifier "8776" .

code:05532C73-0D8A-47D6-AC40-C229C29B4544 a :Obligation ;
    schema:description "Beizen des Saatguts: Schutzhandschuhe + Schutzanzug + Schutzbrille + Atemschutzmaske (P2) tragen."@de,
        "Lors de la désinfection des semences: Porter des gants de protection + une tenue de protection + des lunettes de protection + un masque de protection respiratoire (P2)."@fr,
        "Nel processo di concia: Indossare guanti di protezione + indumenti protettivi + occhiali di protezione + una maschera di protezione per le vie respiratorie (P2)."@it ;
    schema:identifier "13371" .

code:057C0C8A-99FA-43DF-B49F-40D3833DB8D4 a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzhandschuhe tragen."@de,
        "Préparation de la bouillie: Porter des gants de protection."@fr,
        "Durante la preparazione della poltiglia: Indossare guanti di protezione."@it ;
    schema:identifier "12360" .

code:05B1AD11-F662-4805-AEA8-95F6C5FCCBDC a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 1 Behandlung pro Kultur mit Produkten aus der Wirkstoffgruppe FRAC Nr. 3 (DeMethylation Inhibitors, DMI = Sterolsynthesehemmer, SSH)."@de,
        "SPa 1: Pour éviter le développement de résistances, 1 traitement au maximum par culture avec des produits du groupe de matières actives FRAC no 3 (DeMethylation Inhibitors, DMI = inhibiteurs de la synthèse des stérols, ISS)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 1 trattamento per cultura con prodotti del gruppo di principi attivi FRAC no 3 (DeMethylation Inhibitors, DMI = inibitori della sintesi degli steroli, ISS)."@it ;
    schema:identifier "15937" .

code:05FFF155-A20A-4775-9594-5C2097B794E5 a :Obligation ;
    schema:description "Max. 3 Splitbehandlungen, max. 2 l/ha je Split."@de,
        "3 traitements fractionnés au maximum, max. 2 l/ha par traitement."@fr,
        "3 trattamenti frazionati al massimo, max. 2 l/ha per trattamento."@it ;
    schema:identifier "14075" .

code:06177CF7-949F-41CB-9047-605566C34273 a :Obligation ;
    schema:description "Nur in Tankmischung mit 0.1% Captan (80% WG) oder 0.05% Dithianon (75% WP)."@de,
        "Uniquement en mélange avec 0.1% de Captan (80% WG) ou 0.05% Dithianon (75% WP)."@fr,
        "Soltanto in combinazione con 0.1% di Captan (80% WG) o con 0.05% Dithianon (75% WP)."@it ;
    schema:identifier "9875" .

code:06297F0A-C051-445A-83C5-51AF3DF63B75 a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzhandschuhe + Schutzanzug tragen. Ausbringen der Spritzbrühe: Schutzanzug tragen. Technische Schutzvorrichtungen während des Ausbringens (z.B. geschlossene Traktorkabine) können die vorgeschriebene persönliche Schutzausrüstung ersetzen, wenn gewährleistet ist, dass sie einen vergleichbaren oder höheren Schutz bieten."@de,
        "Préparation de la bouillie: Porter des gants de protection + une tenue de protection. Application de la bouillie: Porter une tenue de protection. Les équipements techniques utilisés lors de l'application (p. ex. cabine de tracteur fermée) peuvent remplacer les équipements personnels de protection s'ils offrent de manière avérée une protection semblable ou supérieure."@fr,
        "Durante la preparazione della poltiglia: Indossare guanti di protezione + indumenti protettivi. Applicazione della poltiglia: Indossare indumenti protettivi. I dispositivi di protezione individuale possono essere sostituiti, durante l'applicazione, da dispositivi di protezione tecnici (p.es. cabina del trattore chiusa), qualora vi sia la garanzia che offrano una protezione analoga o superiore."@it ;
    schema:identifier "15639" .

code:0642D10D-60B5-43B6-9886-7F2FC974D437 a :Obligation ;
    schema:description "SPe 8 - Gefährlich für Bienen: Darf nicht mit blühenden oder Honigtau aufweisenden Pflanzen (z.B. Kulturen, Einsaaten, Unkräutern, Nachbarkulturen, Hecken) in Kontakt kommen. Blühende Einsaaten oder Unkräuter sind vor der Behandlung zu entfernen (am Vortag mähen/mulchen)."@de,
        "SPe 8 - Dangereux pour les abeilles : Ne doit pas entrer en contact avec des plantes en fleur ou exsudant du miellat (p.ex. cultures, enherbement, adventices, cultures environnantes, haies). Les plantes d'enherbement et les adventices en fleurs doivent être éliminés avant le traitement (faucher ou mulcher la veille)."@fr,
        "SPe 8 - Pericoloso per le api: non deve entrare in contatto con piante in fiore o che presentano melata (p.es. colture, colture intercalari, malerbe, colture vicine, siepi). Le colture intercalari e le malerbe in fiore devono essere eliminate prima del trattamento (il giorno prima sfalciare/trinciare l'erba)."@it ;
    schema:identifier "9263" .

code:06615CF7-B5E2-4A43-9C2A-A7DFAFE8921D a :Obligation ;
    schema:description "Nachfolgearbeiten in behandelten leeren Räumen: Schutzbrille + Atemschutz P3 tragen."@de,
        "Travaux successifs dans des locaux vides traités: porter des lunettes de protection + un masque de protection respiratoire P3."@fr,
        "Lavori successivi in locali vuoti trattati: indossare occhiali protettivi + una maschera di protezione per le vie respiratorie P3."@it ;
    schema:identifier "13412" .

code:066882D8-4A7A-4FDC-A27F-F3CB35144D03 a :Obligation ;
    schema:description "Eine Behandlung mit der höheren Dosierung oder zwei Behandlungen mit der niedrigeren Dosierung."@de,
        "Un traitement avec le dosage plus élevé ou deux traitements avec le dosage plus faible."@fr,
        "Un solo trattamento con la dose più elevata o due trattementi con la dose piu bassa."@it ;
    schema:identifier "9876" .

code:06B209EC-97F6-47A5-A79E-573F7F5F6F03 a :Obligation ;
    schema:description "Bei Befall 2-3 Behandlungen im Abstand von 7-10 Tagen."@de,
        "Dès l'apparition de l'attaque, 2 à 3 applications avec un intervalle de 7 à 10 jours."@fr,
        "Dalla comparsa dell'attacco, 2 - 3 applicazioni a intervalli di 7 - 10 giorni."@it ;
    schema:identifier "9189" .

code:06CCDA8C-90BA-4F36-BD27-3805D1DD2DA1 a :Obligation ;
    schema:description "Brühemenge: 1000 l/ha."@de,
        "Quantité de bouillie: 1000 l/ha."@fr,
        "Quantitativo di poltiglia: 1000 l/ha."@it ;
    schema:identifier "9618" .

code:07027A60-6BC7-4BBB-A795-063590CE6F93 a :Obligation ;
    schema:description "1-2 Behandlungen."@de,
        "1-2 traitements."@fr,
        "1-2 trattamenti."@it ;
    schema:identifier "9412" .

code:07373A2D-2EB5-4102-AE80-D6C700BF7221 a :Obligation ;
    schema:description "Maximal 2 Behandlungen pro Parzelle und Jahr im Abstand von mindestens 2 Wochen."@de,
        "2 traitements en maximum par parcelle et par année avec au moins 2 semaines d'intervalle."@fr,
        "Al massimo 2 trattamenti per particella e per anno ad un intervallo di almeno 2 settimane."@it ;
    schema:identifier "14111" .

code:0799E077-241A-4BAF-9209-695C600F380F a :Obligation ;
    schema:description "Mit Motor- oder Rückenspritze in 500-1500 L Wasser, mit Rückennebelblaser in 250-400 L Wasser."@de,
        "Avec sulfateuse à moteur ou sulfateuse à dos dans 500-1500 l d'eau, avec nébulisateur à dos dans 250-400 l d'eau."@fr,
        "Con motoirroratrice o vaporizzatore a zaino in 500 - 1500 l di acqua, con nebulizzatore a zaino in 250 - 400 l di acqua."@it ;
    schema:identifier "8145" .

code:07C33788-D57E-48AB-B0AA-122D014CC8E5 a :Obligation ;
    schema:description "In Tankmischung mit 2 - 2.5 l/ha Phenmedipham."@de,
        "En mélange avec 2 - 2.5 l/ha de phenmedipham."@fr,
        "In combinazione con 2 - 2.5 l/ha Fenmedifam."@it ;
    schema:identifier "9774" .

code:082554C2-1526-4381-8990-3BF519245AAA a :Obligation ;
    schema:description "Nur präventiv eingesetzt gegen Sekundärbefall wirksam."@de,
        "Efficace contre les infections secondaires seulement si traité préventivement."@fr,
        "Efficace contro le infezioni secondarie solamente se trattato in maniera preventiva."@it ;
    schema:identifier "9703" .

code:08375CB6-CBBB-4957-B386-F68ED2350FB3 a :Obligation ;
    schema:description "Bodenbehandlung: Nach Anwendung sofort in den Boden einarbeiten."@de,
        "Traitement du sol: Incorporer dans le sol immédiatement après l'application."@fr,
        "Trattamento del suolo: Incorporare nel terreno subito dopo l'applicazione."@it ;
    schema:identifier "9601" .

code:0893BCC2-A6A4-418E-A016-07830246464F a :Obligation ;
    schema:description "Bei der Anwendung: Schutzhandschuhe + Schutzanzug + Schutzbrille + Atemschutz (B2) tragen.  Nach der Anwendung: Raum sofort verlassen und Raum gut verschliessen."@de,
        "Lors de l'application: Porter des gants de protection + une tenue de protection + des lunettes de protection + un masque de protection respiratoire (B2).  Après l'application: quitter le local immédiatement et bien refermer la porte."@fr,
        "Durante l'applicazione: Indossare guanti di protezione + indumenti protettivi + occhiali di protezione + una maschera di protezione per le vie respiratorie (B2).  Dopo l'applicazione: abbandonare immediatamente i locali e chiuderli bene."@it ;
    schema:identifier "13632" .

code:08F1FA3F-F421-4BDA-A594-D7240759B324 a :Obligation ;
    schema:description "Das Produkt  vor dem Gebrauch gut schütteln. Im Spritztank bei laufendem Rührwerk anwenden. Bei Spritzgeräten ohne Rührwerk Brühe regelmässig schütteln/rühren."@de,
        "Bien agiter le produit avant l'utilisation. Utiliser avec une cuve avec appareil de brassage en marche. Si la cuve n'en dispose pas, agiter ou remuer régulièrement la bouillie."@fr,
        "Agitare bene il prodotto prima dell'uso. Impiegare con un serbatoio per la poltiglia con miscelatore in funzione. Per gli apparecchi di irrorazione senza miscelatore agitare/rimescolare la poltiglia regolarmente."@it ;
    schema:identifier "13407" .

code:090537DE-A043-44C5-86F0-0ED32201A0B2 a :Obligation ;
    schema:description "Auf der Gebrauchsanweisung ist die Liste der Sorten aufzuführen, welche das Präparat vertragen."@de,
        "Faire figurer dans le mode d'emploi la liste des variétés qui tolèrent le produit."@fr,
        "Nelle istruzioni per l'uso far figurare l'elenco delle varietà che tollerano il prodotto."@it ;
    schema:identifier "8151" .

code:0962C1BF-9E6E-46A7-9016-A2D084CF0BB7 a :Obligation ;
    schema:description "Mehrere Freilassungen bis die Bekämpfung erreicht ist."@de,
        "Répéter les lâchers jusqu'à l'obtention d'une efficacité suffisante."@fr,
        "Effettuare più lanci fino al raggiungimento dell'efficacia."@it ;
    schema:identifier "8903" .

code:099DDFBC-E3BC-46D2-84A2-4BA8799F72C1 a :Obligation ;
    schema:description "Beizen des Saatguts: Schutzhandschuhe + Schutzanzug + Visier tragen. Technische Schutzvorrichtungen beim Beizvorgang (z.B. geschlossene Systeme) können  die vorgeschriebene persönliche Schutzausrüstung ersetzen, wenn gewährleistet ist, dass  sie einen vergleichbaren oder höheren Schutz bieten"@de,
        "Lors de la désinfection des semences: Porter des gants de protection + un vêtement de protection + visière. Les équipements techniques utilisés lors de la désinfection des semences (p. ex. systèmes fermés) peuvent remplacer les équipements personnels de protection s'ils offrent de manière avérée une protection semblable ou supérieure."@fr,
        "Nel processo di concia: indossare guanti di protezione + indumenti protettivi + visiera. I dispositivi di protezione individuale possono essere sostituiti, durante il processo di concia, da dispositivi di protezione tecnici (p.es. sistemi chiusi), qualora vi sia la garanzia che offrano una protezione analoga o superiore."@it ;
    schema:identifier "15934" .

code:0A9D9A3C-73F8-47AA-B046-B23A23C2A241 a :Obligation ;
    schema:description "Brühemenge: 500 - 1000 l/ha."@de,
        "Quantité de bouillie: 500 - 1000 l/ha."@fr,
        "Quantitativo di poltiglia: 500 - 1000 l/ha."@it ;
    schema:identifier "9756" .

code:0ACE75E1-F02E-41AA-93B4-01DEBE6BF442 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 4 Behandlungen pro Parzelle und Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr. 40 (Carboxylic acid amides, CAA)."@de,
        "SPa 1: Pour éviter le développement de résistances, 4 traitements au maximum par parcelle et par année avec des produits du groupe de matières actives FRAC N° 40 (carboxylic acid amides, CAA)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 4 trattamenti per anno e particella con prodotti del gruppo di principi attivi FRAC numero 40 (Carboxylic acid amides, CAA)."@it ;
    schema:identifier "14532" .

code:0AEF1730-BDF7-44B0-BD55-07935DB2E580 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 3 Behandlungen pro Kultur und Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr. 40."@de,
        "SPa 1: Pour éviter le développement de résistances, 3 traitements au maximum par culture et par année avec des produits du groupe de matières actives FRAC N° 40."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 3 trattamenti per anno e coltura con prodotti del gruppo di principi attivi FRAC numero 40."@it ;
    schema:identifier "14521" .

code:0B12C74A-2384-45D9-8A99-5EAE7CBD5856 a :Obligation ;
    schema:description "Nicht kombiniert mit anderen Pflanzenschutzmitteln anwenden."@de,
        "Ne pas utiliser en combinaison avec d'autres produits phytosanitaires."@fr,
        "Non usare in combinazione con altri prodotti fitosanitari."@it ;
    schema:identifier "14458" .

code:0B3B8E96-1067-4CFE-91CA-E2688D35AA22 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung darf dieses oder irgendein anderes Produkt, welches einen Wirkstoff aus der Wirkstoffgruppe der SSH (Sterolsynthesehemmer) enthält, nicht mehr als 3 mal pro Parzelle und Jahr ausgebracht werden."@de,
        "SPa 1: Pour éviter le développement de résistances, ne pas appliquer ce produit ou tout autre produit contenant un inhibiteur de la synthèse des stérols (ISS) plus de 3 fois par parcelle et par année."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenze, effettuare al massimo 3 trattamenti per anno e particella con prodotti contenenti principi attivi del gruppo dei ISS."@it ;
    schema:identifier "12582" .

code:0B409E7A-F6B6-4858-B16F-7B9015FF0E2D a :Obligation ;
    schema:description "Nur 1 Anwendung."@de,
        "1 traitment seulement."@fr,
        "Solo 1 trattamento."@it ;
    schema:identifier "9438" .

code:0B71CDD5-FDF8-4DA4-9FC9-15A5CE94D80A a :Obligation ;
    schema:description "Einzelpflanzenbehandlung gemäss Direktzahlungsverordnung (DZV)."@de,
        "Pour le traitement des plants isolés selon l'ordonnance sur les paiements directs (OPD)."@fr,
        "Per il trattamento pianta per pianta secondo l'ordinanza sui pagamenti diretti (OPD)."@it ;
    schema:identifier "9205" .

code:0B7E3532-CF1C-4926-BC3A-4218396F49AD a :Obligation ;
    schema:description "Die Etiketten von Verpackungen mit behandeltem Pflanzgut sind mit folgenden Angaben zu versehen:   - Gebeiztes Pflanzgut. Nicht einnehmen! Überreste dürfen (auch gewaschen) nicht als Futter oder Lebensmittel verwendet werden.   - Die Handelsbezeichnung, Wirkstoff(e), sowie die Sicherheitshinweise des Saatbeizmittels.   - Zum Schutz von Vögeln und wildlebenden Säugetieren muss das behandelte Pflanzgut vollständig in den Boden eingearbeitet werden; es ist sicherzustellen, dass das behandelte Pflanzgut auch am Ende der Saatreihen vollständig in den Boden eingearbeitet ist.   - Zum Schutz von Vögeln und wildlebenden Säugetieren muss verschüttetes Pflanzgut beseitigt werden."@de,
        "Les emballages contenant les plants traités doivent être identifiés par une étiquette portant l'inscription suivante:   - Traité avec un désinfectant des semences. Ne pas ingérer! Il est interdit d'utiliser les restes de plants désinfectés comme fourrage ou pour l'alimentation, même après les avoir lavés.   - Le nom, les substances actives et les phrases types pour les précautions en matière de sécurité du produit désinfectant des semences.   - Pour protéger les oiseaux et les mammifères sauvages, les plants traités doivent être complètement incorporés dans le sol; s'assurer que les plants traités soient également incorporés en bout de sillon.   - Pour protéger les oiseaux et les mammifères sauvages, récupérer toutes les plants traités accidentellement répandus."@fr,
        "Gli imballaggi contenenti materiale da semina conciato devono essere designati con la seguente iscrizione sull'etichetta:   - Sementi conciate. Non ingerire! I residui non devono essere usati come foraggio o alimento, neanche se lavati.   - La denominazione commerciale , il(i) principio(i) attivo(i) e le frasi tipo per precauzioni da prendere del prodotto per la concia delle sementi.   - Per proteggere gli uccelli e i mammiferi selvatici il materiale da semina conciato dev' essere interamente incorporato al terreno; assicurarsi che il materiale è completamente incorporato all'estremità dei solchi.   - Per proteggere uccelli e mammiferi selvatici, eliminare il materiale da semina trattato sparso."@it ;
    schema:identifier "11884" .

code:0B9EC9C8-D293-458B-B0A2-D0DA869B2737 a :Obligation ;
    schema:description "Anwendung nur in Kulturen zur Produktion von getrockneten Samen und Früchten."@de,
        "Application seulement dans des cultures destinées à la production de fruits et semences séchés."@fr,
        "Applicazione solamente in colture destinate alla produzione di semi e frutta seccha."@it ;
    schema:identifier "13680" .

code:0BC72CC4-4BA4-4D4B-BBBD-F4F70AF6E498 a :Obligation ;
    schema:description "Splitbehandlung gemäss den Angaben der Bewilligungsinhaberin (max. 3 l/ha je Split, angegebene Aufwandmenge entspricht total bewilligter Menge)."@de,
        "Traitemtent fractionné conformément aux indications du titulaire de l'autorisation (max. 3 l/ha par traitement, le dosage indiqué correspond à la quantité totale autorisée)."@fr,
        "Trattamtno frazionato conformemente alle indicazioni del titolare dell'autorizzazione (max. 3 l/ha per trattamento, la dose indicata corrisponde al quantitativo totale autorizzato)."@it ;
    schema:identifier "15205" .

code:0C268A85-3BD4-493E-83D0-427A15066EA3 a :Obligation ;
    schema:description "Behandlungsintervall mindestens 21 Tage."@de,
        "Intervalles de (au moins) 21 jours entre les traitements."@fr,
        "Intervalli di (al meno) 21 giorni tra i trattamenti."@it ;
    schema:identifier "14584" .

code:0C40142E-C8AB-4A0E-BC80-47567A9EAFD5 a :Obligation ;
    schema:description "Keine Anwendung, wenn ungeschützte Personen der Drift ausgesetzt sein könnten."@de,
        "Pas de traitements, en présence de personnes non protégées qui risquent d'être exposés à la dérive."@fr,
        "Nessun trattamento, in presenza di persone non protette che potrebbero essere esposte alla deriva."@it ;
    schema:identifier "13898" .

code:0C450239-475E-4BB3-A23C-48217DD8CF89 a :Obligation ;
    schema:description "Die Anwendung von Produkten, die Phosphorwasserstoff freisetzen, darf im Freiland nur von Personen, die im Besitz einer Fachbewilligung für die Schädlingsbekämpfung mit Begasungsmitteln oder einer Fachbewilligung für die Verwendung von Pflanzenschutzmitteln in der Landwirtschaft und im Gartenbau sind, erfolgen. Die Anwendung durch Drittpersonen unter Anleitung eines Inhabers der Fachbewilligung ist nicht zulässig."@de,
        "Les produits qui libèrent de l'hydrure de phosphore ne peuvent être employés en grandes quantités en plein air que par des personnes titulaires d'un permis professionnel pour l'emploi des fumigants ou d'un permis professionnel pour l'emploi de produits phytosanitaires dans l'agriculture et l'horticulture. L'utilisation par un tiers sur instruction d'une personne titulaire d'un permis n'est pas autorisée."@fr,
        "L'utilizzo di prodotti che liberano fosfina può avvenire all'aperto in grandi quantità solo da parte di persone in possesso di una autorizzazione speciale per la lotta antiparassitaria con fumiganti o una autorizzazione speciale per l'impiego di prodotti fitosanitari nell'agricoltura, nell'orticoltura e nel giardinaggio. Non è consentito l'utilizzo da parte di terze persone anche dopo un'istruzione impartita da un titolare di un'autorizzazione speciale."@it ;
    schema:identifier "15840" .

code:0C765EFB-35A2-4F35-A5DA-7CB5982E7E1D a :Obligation ;
    schema:description "Sortenempfindlichkeit beachten."@de,
        "Tenir compte de la sensibilité des variétés."@fr,
        "Tener presente la sensibilità delle varietà."@it ;
    schema:identifier "8369" .

code:0C9627AF-B151-4BB9-8F14-06E8F7AFEFD4 a :Obligation ;
    schema:description "Behandlungen im Abstand von 10-21 Tagen."@de,
        "10 à 21 jours d'intervalle entre les traitements."@fr,
        "Trattamenti a intervalli di 10-21 giorni."@it ;
    schema:identifier "14356" .

code:0D315B4D-0846-48F5-ADE9-102C2AF86DAD a :Obligation ;
    schema:description "Nur in Tankmischung mit Malvin WG 0.1% (1.6 kg/ha) oder mit 336 g Dithianon pro ha eines Dithianon-haltigen Produktes."@de,
        "Seulement en mélange avec Malvin WG 0.1% (1.6 kg/ha) ou avec 336 g dithianon par ha avec un produit contenant la substance active dithianon."@fr,
        "Soltanto in combinazione con Malvin WG 0.1% (1.6 kg/ha) o con 336 g Ditianon per ha con/di un prodotto contenente la sostanza attiva Ditianon."@it ;
    schema:identifier "14127" .

code:0DA62166-7166-4718-B4E2-883F3A741C6F a :Obligation ;
    schema:description "Erste Behandlung vor Befallsbeginn. Behandlung im Abstand von 7-10 Tagen wiederholen."@de,
        "Première application avant le début de l'attaque. Répéter le traitement tous les 7-10 jours."@fr,
        "1° trattamento prima dell'inizio dell'infestazione. Ripetere l'applicazione tutti i 7-10 giorni."@it ;
    schema:identifier "11356" .

code:0DC39C0A-1397-46AC-9422-E376EFCC9E86 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 3 Behandlungen pro Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr. 40 (Carboxylic acid amides, CAA)."@de,
        "SPa 1: Pour éviter le développement de résistances, 3 traitements au maximum par année avec des produits du groupe de matières actives FRAC N° 40 (carboxylic acid amides, CAA)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 3 trattamenti per anno con prodotti del gruppo di principi attivi FRAC numero 40 (Carboxylic acid amides, CAA)."@it ;
    schema:identifier "15942" .

code:0DE1AD34-427A-481D-9E54-EC2201BFC901 a :Obligation ;
    schema:description "Risiko von vorübergehenden Blattchlorosen."@de,
        "Risque de chloroses passagères."@fr,
        "Rischio di clorosi temporanea della foglia."@it ;
    schema:identifier "9937" .

code:0DE6DD71-A980-411F-B920-6C3C2C124BF6 a :Obligation ;
    schema:description "Nur in Tankmischung mit Malvin WG 0.1% (1.6 kg/ha) oder mit 336 g Dithianon pro ha eines Dithianon-haltigen Produktes."@de,
        "Seulement en mélange avec Malvin WG 0.1% (1.6 kg/ha) ou avec 336 g dithianon par ha avec un produit contenant la substance active dithianon."@fr,
        "Soltanto in combinazione con Malvin WG 0.1% (1.6 kg/ha) o con 336 g Ditianon per ha con/di un prodotto contenente la sostanza attiva Ditianon."@it ;
    schema:identifier "14125" .

code:0E6CB748-B04B-4A29-BBE6-A45C16608F3C a :Obligation ;
    schema:description "Für alle Anwendungen (Feuerbrand + Hemmung des Triebwachstums): maximal 0.3 kg Prohexadione-Calcium pro Hektar und Jahr."@de,
        "Pour toutes les applications (feu bactérien + inhibition de la croissance des rameaux): 0.3 kg de Prohexadione-Calcium au maximum par hectare et par année."@fr,
        "Per tutte le applicazioni (Fuoco batterico + Inibizione della crescita dei polloni): al massimo 0.3 kg di Prohexadione-Calcium per anno ed ettaro."@it ;
    schema:identifier "14398" .

code:0EC86C45-D8E9-462F-B386-78DB3280BF4C a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzbrille + Atemschutzmaske (A2) tragen."@de,
        "Préparation de la bouillie: Porter un masque de protection respiratoire (A2) + des lunettes de protection."@fr,
        "Durante la preparazione della poltiglia: Indossare una maschera di protezione per le vie respiratore (A2) + occhiali di protezione."@it ;
    schema:identifier "14157" .

code:0F033139-F182-4F05-8E44-F124FACB95C9 a :Obligation ;
    schema:description "Anwendung  mit Aktivschaumgerät: Schutzanzug + Schutzbrille tragen."@de,
        "Utilisation avec un appareil à mousse active : Porter une tenue de protection + des lunettes de protection."@fr,
        "Applicazione con unità di schiuma attiva: Indossare indumenti protettivi + occhiali di protezione."@it ;
    schema:identifier "15424" .

code:0F48F158-01DC-4359-9A5F-E22A56137946 a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzhandschuhe tragen. Ausbringen der Spritzbrühe: Schutzhandschuhe + Schutzanzug + Kopfbedeckung tragen. Technische Schutzvorrichtungen während des Ausbringens (z.B. geschlossene Traktorkabine) können die vorgeschriebene persönliche Schutzausrüstung ersetzen, wenn gewährleistet ist, dass sie einen vergleichbaren oder höheren Schutz bieten."@de,
        "Préparation de la bouillie: Porter des gants de protection. Application de la bouillie: Porter des gants de protection + une tenue de protection + un couvre-chef. Les équipements techniques utilisés lors de l'application (p. ex. cabine de tracteur fermée) peuvent remplacer les équipements personnels de protection s'ils offrent de manière avérée une protection semblable ou supérieure."@fr,
        "Durante la preparazione della poltiglia: Indossare guanti di protezione. Applicazione della poltiglia: Indossare guanti di protezione + indumenti protettivi + un copricapo. I dispositivi di protezione individuale possono essere sostituiti, durante l'applicazione, da dispositivi di protezione tecnici (p.es. cabina del trattore chiusa), qualora vi sia la garanzia che offrano una protezione analoga o superiore."@it ;
    schema:identifier "12421" .

code:0F4D9659-1D49-4C28-A0D7-B7F3BD83BADE a :Obligation ;
    schema:description "Behandlung der unbearbeiteten Zwischenreihen bei der Streifenfrässaat."@de,
        "Traitement de la surface non travalliée entre les lignes lors du semis en bandes fraisées."@fr,
        "Trattamento della superficie non lavorata tra le file durante la semina a bande fresate."@it ;
    schema:identifier "12836" .

code:0F4EFD74-3AD4-4FA6-8B82-5BA5546592DB a :Obligation ;
    schema:description "3 Wochen Wartefrist bis zum nächsten Weidegang."@de,
        "Délai d'attente jusqu'à la prochaine pâture: 3 semaines."@fr,
        "Termine di attesa fino al pascolo successivo: 3 settimane."@it ;
    schema:identifier "8484" .

code:0F5B9C74-6211-444F-82D5-6338BABDFA91 a :Obligation ;
    schema:description "Die Anwendung von Produkten, die Phosphorwasserstoff freisetzen, darf im Freiland nur von Personen, die im Besitz einer Fachbewilligung für die Schädlingsbekämpfung mit Begasungsmitteln oder einer Fachbewilligung für die Verwendung von Pflanzenschutzmitteln in der Landwirtschaft und im Gartenbau sind, erfolgen. Die Anwendung durch Drittpersonen unter Anleitung eines Inhabers der Fachbewilligung ist nicht zulässig."@de,
        "Les produits qui libèrent de l'hydrure de phosphore ne peuvent être employés en grandes quantités en plein air que par des personnes titulaires d'un permis professionnel pour l'emploi des fumigants ou d'un permis professionnel pour l'emploi de produits phytosanitaires dans l'agriculture et l'horticulture. L'utilisation par un tiers sur instruction d'une personne titulaire d'un permis n'est pas autorisée."@fr,
        "L'utilizzo di prodotti che liberano fosfina può avvenire all'aperto in grandi quantità solo da parte di persone in possesso di una autorizzazione speciale per la lotta antiparassitaria con fumiganti o una autorizzazione speciale per l'impiego di prodotti fitosanitari nell'agricoltura, nell'orticoltura e nel giardinaggio. Non è consentito l'utilizzo da parte di terze persone anche dopo un'istruzione impartita da un titolare di un'autorizzazione speciale."@it ;
    schema:identifier "11965" .

code:0F7C2E5D-7200-4450-9347-173150E0251B a :Obligation ;
    schema:description "SPe 3: Zum Schutz von Gewässerorganismen vor den Folgen von Drift eine unbehandelte Pufferzone von 50 m zu Oberflächengewässern einhalten. Zum Schutz vor den Folgen einer Abschwemmung müssen die Fahrgassen mit einer geschlossenen Pflanzendecke bedeckt sein. Reduktion der Distanz aufgrund von Drift und Ausnahmen gemäss den Weisungen der Zulassungsstelle."@de,
        "SPe 3: Pour protéger les organismes aquatiques des conséquences liées à la dérive, respecter une zone tampon non traitée de 50 m par rapport aux eaux de surface. Pour protéger des conséquences liées au ruissellement la zone entre les rangs doit être entièrement végétalisée. La réduction de la zone liée à la dérive et les dérogations sont fixées dans les instructions du service d'homologation."@fr,
        "SPe 3: Per proteggere organismi acquatici dagli effetti della deriva rispettare una zona tampone non trattata di 50 metri dalle acque superficiali. Per la protezione contro gli effetti di un dilavamento, le corsie devono essere ricoperte con una copertura vegetale compatta. Riduzione della distanza a causa di deriva ed eccezioni secondo le istruzioni del Servizio di omologazione."@it ;
    schema:identifier "13845" .

code:0F8A187C-F916-42D6-AD61-095F8CE4431B a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung dürfen Pflanzenschutzmittel mit einen Wirkstoff der Gruppe der SDHI nicht mehr als 3 Mal und Pflanzenschutzmittel mit einem Wirkstoff der Gruppe der QoI (Quinone outside Inhibitors) nicht mehr als 4 Mal pro Jahr ausgebracht werden, wobei höchstens 2 aufeinander folgende QoI Behandlungen erlaubt sind."@de,
        "SPa 1: Pour éviter le développement de résistances, ne pas appliquer des produits contenant une matière active du groupe des SDHI plus de 3 fois et des produits contenant une matière active du groupe des QoI (Quinone outside Inhibitors) plus de 4 fois par année et pas plus de 2 traitements QoI consécutifs."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenze non applicare prodotti contenenti un principio attivo del gruppo dei SDHI più di 3 volte all'anno e prodotti contenenti un principio attivo del gruppo dei QoI (Quinone outside Inhibitors) più di 4 volte all'anno; sono consentiti al massimo 2 trattamenti Qol consecutivi."@it ;
    schema:identifier "12803" .

code:0F941AF6-0A8C-4519-A7BA-D64F2085A622 a :Obligation ;
    schema:description "1-2 Behandlungen im Abstand von 7-10 Tagen."@de,
        "1-2 traitements avec un intervalle de 7-10 jours."@fr,
        "1-2 trattamenti in un intrvallo di 7-10 giorni."@it ;
    schema:identifier "9437" .

code:0FC1B332-B255-457D-B7B8-C9740B0927FE a :Obligation ;
    schema:description "Keine Niederschläge während mindestens 3 Stunden nach der Behandlung."@de,
        "Pas de précipitations pendant 3 heures au moins après le traitement."@fr,
        "Non devono esserci precipitazioni durante almeno 3 ore dopo il trattamento."@it ;
    schema:identifier "15464" .

code:0FEC9B00-BE94-4947-B3C7-3A274F65AFB6 a :Obligation ;
    schema:description "Vor einem grossflächigen Einsatz muss die Pflanzenverträglichkeit auf einzelnen Pflanzen getestet werden."@de,
        "Avant l'utilisation extensive, vérifier sur des plantes isoléees que la plante résiste au traitement."@fr,
        "Prima dell'intervento ampio occorre verificare su singoli piante la tolleranza della pianta al trattamento."@it ;
    schema:identifier "11794" .

code:1007D8F2-B6BD-441E-B553-A14015B523ED a :Obligation ;
    schema:description "Die Behandlung kann zu gelblichen Verfärbungen, Welkeerscheinungen und Seneszenz bei der Kultur führen."@de,
        "Le traitement peut entrainer des colorations jaunes, un flétrissement et une sénéscence des cultures."@fr,
        "Il trattamento può causare colorazioni giallastre, avvizzimento e senescenza nella coltura."@it ;
    schema:identifier "14061" .

code:106BBBDE-11F5-4DA1-8412-58C3051B701C a :Obligation ;
    schema:description "Ausbringen der Spritzbrühe: Schutzhandschuhe + Schutzanzug tragen. Technische Schutzvorrichtungen während des Ausbringens (z.B. geschlossene Traktorkabine) können die vorgeschriebene persönliche Schutzausrüstung ersetzen, wenn gewährleistet ist, dass sie einen vergleichbaren oder höheren Schutz bieten."@de,
        "Application de la bouillie: Porter des gants de protection + une tenue de protection. Les équipements techniques utilisés lors de l'application (p. ex. cabine de tracteur fermée) peuvent remplacer les équipements personnels de protection s'ils offrent de manière avérée une protection semblable ou supérieure."@fr,
        "Applicazione della poltiglia: Indossare guanti di protezione + indumenti protettivi. I dispositivi di protezione individuale possono essere sostituiti, durante l'applicazione, da dispositivi di protezione tecnici (p.es. cabina del trattore chiusa), qualora vi sia la garanzia che offrano una protezione analoga o superiore."@it ;
    schema:identifier "15907" .

code:109BF1EA-AEC3-4765-B7F9-57A455FEF410 a :Obligation ;
    schema:description "Maximal 2 Behandlungen pro Jahr."@de,
        "2 traitements au maximum par année."@fr,
        "Al massimo 2 trattamenti per anno."@it ;
    schema:identifier "8416" .

code:10C82FB9-FE73-428C-894C-4526207AFCD2 a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzbrille oder Visier tragen."@de,
        "Préparation de la bouillie: Porter des lunettes de protection ou une visière"@fr,
        "Durante la preparazione della poltiglia: Indossare occhiali di protezione o una visiera."@it ;
    schema:identifier "12141" .

code:10E005CE-8E49-4EF9-8216-235D2D1B0B2F a :Obligation ;
    schema:description "Als Zusatz zu den durch die Firma zu bestimmenden Fungiziden und Insektiziden."@de,
        "En adjonction aux fongicides et aux insecticides indiqués par la firme."@fr,
        "In aggiunta ai fungicidi e agli insetticidi stabiliti dalla ditta."@it ;
    schema:identifier "9544" .

code:10E3210E-2BE6-490F-989A-82A3D902900A a :Obligation ;
    schema:description "Durch den Einsatz des Produktes kann es zu einem höheren Fruchtansatz kommen. Im Folgejahr ist auch ein reduzierter Blütenansatz möglich."@de,
        "L'utilisation du produit peut provoquer une fructification plus importante. L'année suivante, il est également possible que la floraison soit réduite."@fr,
        "L'uso del prodotto può determinare una fruttificazione più elevata. È possibile anche una ridotta infiorescenza nell'anno successivo."@it ;
    schema:identifier "15894" .

code:112570E0-E586-4393-A032-CFC7A7CA54C8 a :Obligation ;
    schema:description "Bis spätestens Mitte August."@de,
        "Jusqu'à la mi-août au plus tard."@fr,
        "Al più tardi entro metà agosto."@it ;
    schema:identifier "9090" .

code:112EC443-614F-4EE7-B2BD-09E40B3B8D60 a :Obligation ;
    schema:description "Im späten Frühjahr / Sommer v.a. gegen Arten der Gattungen Aphis und Myzus."@de,
        "A la fin du printemps / été, surtout contre les espèces appartenant aux genres Aphis et Myzus."@fr,
        "In primavera inoltrata / estate soprattutto contro specie del genere Aphis e Myzus."@it ;
    schema:identifier "12963" .

code:11418388-1A15-4419-9D60-4A15002955C1 a :Obligation ;
    schema:description "Anlagegrösse nicht unter 1-2 ha."@de,
        "La surface de plantation doit être de 1 à 2 ha au minimum."@fr,
        "La dimensione della piantagione non deve essere inferiore a     1 - 2 ha."@it ;
    schema:identifier "9135" .

code:114A5073-3CAF-4485-8663-5415E604ED3A a :Obligation ;
    schema:description "1 Beutel = 250 Organismen."@de,
        "1 Sachet = 250 organismes."@fr,
        "1 sacchetto = 250 organismi."@it ;
    schema:identifier "15634" .

code:114B3E97-46FD-4F27-86AB-E5C9841271A0 a :Obligation ;
    schema:description "Maximal 2 Behandlungen pro Kultur im Abstand von mindestens 3 Wochen."@de,
        "2 traitements en maximum par culture avec au moins 3 semaines d'intervalle."@fr,
        "2 trattamenti per coltura ad un intervallo di almeno 3 settimane."@it ;
    schema:identifier "14054" .

code:118A2AA9-C522-4359-989A-0AD2B78EA968 a :Obligation ;
    schema:description "Keine Behandlung von Tafelobst."@de,
        "Pas de traitement de fruits de table."@fr,
        "Non trattare su frutta da tavola."@it ;
    schema:identifier "15152" .

code:1193CBE5-69C8-4722-AD20-98D8422DAFA7 a :Obligation ;
    schema:description "Splitbehandlung. 1. Behandlung: max. 1.0 l/ha; 2. Behandlung: max. 1.0 l/ha (angegebene Aufwandmenge entspricht total bewilligter Menge)."@de,
        "Traitement fractionné. 1er traitement: max. 1.0 l/ha; 2ème traitement: max. 1.0 l/ha (le dosage indiqué correspond à la quantité totale autorisée)."@fr,
        "Trattamento frazionato. 1o trattamento: max. 1.0 l/ha; 2o trattamento: max.1.0 l/ha (la dose indicata corrisponde al quantitativo totale autorizzato)."@it ;
    schema:identifier "15265" .

code:1194F6A4-0927-47C9-9A7A-0F571DD24F14 a :Obligation ;
    schema:description "Behandelte Geräte nicht verwenden, bevor die Oberfläche getrocknet ist."@de,
        "Ne pas utiliser les appareils traités avant que la surface ne soit sèche."@fr,
        "Non utilizzare le attrezzature trattate finché la superficie non si è asciugata."@it ;
    schema:identifier "15425" .

code:11D5ACD4-C206-435E-B838-7E3E0AB535AE a :Obligation ;
    schema:description "Betreten der behandelten Räume während Einwirkzeit: Schutzhandschuhe + Schutzanzug + Schutzbrille + Kopfbedeckung + Atemschutzmaske (A2P3) tragen."@de,
        "Accès aux locaux traités pendant la période où le produit agit: Porter des gants de protection + une tenue de protection + des lunettes de protection + un couvre-chef + un masque de protection respiratoire (A2P3)."@fr,
        "Per accedere ai locali trattati nel tempo di azione: Indossare guanti die protezione + indumenti protettivi + occhiali di protezione + un copricapo + una maschera di protezione per le vie respiratorie (A2P3)."@it ;
    schema:identifier "14817" .

code:123EFAD1-11CE-4AD5-A7BC-1FA4AF87C254 a :Obligation ;
    schema:description "Maximal 1 Behandlung pro Jahr."@de,
        "1 traitement au maximum par année."@fr,
        "Al massimo 1 trattamento per anno."@it ;
    schema:identifier "8736" .

code:128DF2F0-EB65-4526-A9B1-80C1D30D2E0A a :Obligation ;
    schema:description "Bewilligt nur für die Behandlung folgender Erntegüter: Getreide, Mais und Tabak."@de,
        "Autorisé seulement pour le traitement des produits récoltés suivantes: céréales, mais et tabac."@fr,
        "Autorizzato esclusivamente per il trattamento dei seguenti prodotti: cereali, mais e tabacco."@it ;
    schema:identifier "15779" .

code:12CBD7F6-5182-412A-A6F6-08170D0BE35C a :Obligation ;
    schema:description "In Tankmischung mit 1 l/ha Bolero."@de,
        "En mélange avec 1 l/ha Bolero."@fr,
        "In combinazione con 1 l/ha Bolero."@it ;
    schema:identifier "11373" .

code:12DE181F-B789-442B-839B-550DF0642B44 a :Obligation ;
    schema:description "Spritzbrühe sofort anwenden."@de,
        "Utiliser la bouillie immédiatement."@fr,
        "Impiegare immediatamente la poltiglia."@it ;
    schema:identifier "13580" .

code:134C44C2-868A-4FC9-BCBE-F2FC5273D943 a :Obligation ;
    schema:description "Angegebene Aufwandmenge entspricht 0.5-1 Aufhängebeutel / m2."@de,
        "Le dosage indiqué correspond à 0.5-1 sachets /m2."@fr,
        "La quantità indicata corrisponde a 0.5-1 sacchetti /m2."@it ;
    schema:identifier "12022" .

code:137A75BC-FCDD-47B1-BF49-76F85A49ED7B a :Obligation ;
    schema:description "Zur Anzucht von Jungpflanzen und Setzlingen, letzte Anwendung spätestens 14 Tage nach der Pflanzung an den definitiven Standort."@de,
        "Pour la culture de jeunes plants, traitement dans les 15 jours suivant la mise en place définitive."@fr,
        "Per l'allevamento di piante giovani e piantine, ultima applicazione al più tardi 14 giorni dopo la piantagione nell'ubicazione definitiva."@it ;
    schema:identifier "8355" .

code:13A22AFC-8264-429A-8157-F1B11DCB9B9C a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 1 Behandlung pro Parzelle und Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr. 49 (oxysterol binding protein homologue inhibition, OSBPI)."@de,
        "SPa 1: Pour éviter le développement de résistances, 1 traitement au maximum par année sur la même parcelle avec des produits du groupe de matières actives FRAC N° 49 (oxysterol binding protein homologue inhibition, OSBPI)."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 1 trattamenti per anno e particella con prodotti del gruppo di principi attivi FRAC numero 49 (oxysterol binding protein homologue inhibition, OSBPI)."@it ;
    schema:identifier "15933" .

code:13ED0455-6314-460A-88F5-08F722A06C97 a :Obligation ;
    schema:description "Nicht bei Sonnenlicht und warmen Temperaturen behandeln, vorzugsweise abends."@de,
        "Ne pas traiter à la lumière du soleil ou lorsque les températures sont élevées, traiter de préférence le soir."@fr,
        "Evitare di trattare alla luce diretta del sole o a temperature calde, prediligere la sera."@it ;
    schema:identifier "9304" .

code:13EDDDD8-EB5F-42B6-9180-169B2DDFBE24 a :Obligation ;
    schema:description "Im Frühjahr nach dem Austrieb, bei einer 5 - 10 cm Wuchshöhe."@de,
        "Au printemps après la levée, lorsque la plante atteint une hauteur de 5 - 10 cm."@fr,
        "In primavera dopo la levata, quando la pianta raggiunge un'altezza di 5 - 10 cm."@it ;
    schema:identifier "9555" .

code:140A2F3F-10B9-416F-9857-FCA16FF68AAD a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzhandschuhe + Schutzanzug + Schutzbrille + Atemschutzmaske (P3) tragen."@de,
        "Préparation de la bouillie : Porter des gants de protection + une tenue de protection + des lunettes de protection + un masque de protection respiratoire (P3)."@fr,
        "Durante la preparazione della poltiglia: Indossare guanti di protezione + indumenti protettivi + occhiali di protezione + una maschera di protezione per le vie respiratore (P3)."@it ;
    schema:identifier "12860" .

code:141C3C7C-E540-4F2F-AB17-DF3545A3D460 a :Obligation ;
    schema:description "Die angegebene Aufwandmenge bezieht sich auf Stadium Fruchtansatz zu 50-90% vorhanden, Heckenvolumen 7'500 m³/ha."@de,
        "Le dosage se réfère au stade de la mise à fruits (50 à 90% des fruits présents), volume de haie 7'500 m³/ha."@fr,
        "La dose indicata si riferisce allo stadio di allegagione al             50 - 90%, volume delle siepi 7'500 m³/ha."@it ;
    schema:identifier "9150" .

code:1440076F-0F6F-4249-BE91-F9891F005B77 a :Obligation ;
    schema:description "Beizen des Saatguts: Schutzhandschuhe + Schutzanzug tragen.  Ansetzen der Beizbrühe: zusätzlich Schutzbrille + Atemschutzmaske (P2) tragen."@de,
        "Lors de la désinfection des semences: Porter des gants de protection + un vêtement de protection. Lors de la préparation de la bouillie désinfectante: porter en plus des lunettes de protection + un masque de protection respiratoire (P2)."@fr,
        "Nel processo di concia: indossare guanti di protezione + indumenti protettivi. Durante la preparazione della poltiglia: Indossare occhiali di protezione + una maschera di protezione per le vie respiratorie (P2)."@it ;
    schema:identifier "13265" .

code:14462622-C19D-4E22-9E82-DB9AF16A64D4 a :Obligation ;
    schema:description "Keine Anwendung direkt vor Regenereignissen und auf Wasser-gesättigten Böden. Keine Anwendung auf durchlässigen Böden."@de,
        "Ne pas appliquer avant des pluies imminentes ni sur des sols saturés en eau. Ne pas appliquer sur des sols perméables."@fr,
        "Nessuna applicazione direttamente prima di eventi piovosi e su terreni saturi d'acqua. Nessuna applicazione su terreni permeabili."@it ;
    schema:identifier "11845" .

code:144BD8C9-A02A-4EA8-B08C-CA15E9B0B1A4 a :Obligation ;
    schema:description "Das Laub behandelter Rüben darf nicht an Tiere verfüttert werden."@de,
        "Les feuilles des betteraves traitées ne doivent pas être utilisées pour l'affouragement des animaux."@fr,
        "Le foglie delle barbabietole trattate non devono essere impiegate per il foraggiamento."@it ;
    schema:identifier "14299" .

code:146C03A5-B3EE-4ACE-9450-98A1175307E9 a :Obligation ;
    schema:description "Spe 1 - Zum Schutz von Grundwasser nur alle 3 Jahre auf derselben Parzelle im Herbst in Getreide anwenden."@de,
        "SPe 1 - Pour protéger les eaux souterraines, n'appliquer que tous les 3 ans sur la même parcelle en automne sur céréales."@fr,
        "SPe 1 - Per proteggere le acque sotterranee, applicare solo ogni 3 anni sulla stessa parcella in autunno nei cereali."@it ;
    schema:identifier "15662" .

code:14B430EA-C185-44D9-BD5D-64AD3EAC021D a :Obligation ;
    schema:description "Zugabe eines durch die Firma zu bestimmenden Adjuvantes 0.5 % auf der Basis von Rapsöl."@de,
        "En complément, un adjuvant (défini par la firme) à 0.5 % sur une base d'huile de colza."@fr,
        "In aggiunta a un adiuvante stabilito dalla ditta (0.5% sulla base di olio di colza)."@it ;
    schema:identifier "8429" .

code:14DE4B0B-C8B4-4C2F-BC64-1506EE099D36 a :Obligation ;
    schema:description "Aprikosen sind schwefelempfindlich, keine Behandlungen."@de,
        "Les abricots ne supportent pas bien le soufre, ne pas traiter."@fr,
        "Le albicocche sono sensibili allo zolfo, evitare trattamenti."@it ;
    schema:identifier "8130" .

code:14E66433-FAFC-4DAA-9A52-4133C54F93D6 a :Obligation ;
    schema:description "Die leere Packung muss zweimal mit Wasser gespült werden, bevor sie entsorgt werden darf."@de,
        "L'emballage vide doit être deux fois rincé à l'eau, avant qu'il ne puisse être mis au rebut."@fr,
        "Il pacchetto vuoto deve essere due volte risciacquato con acqua, prima di poter essere smaltito."@it ;
    schema:identifier "14092" .

code:15975BA3-E098-4E40-96A7-C4DF15A10BF2 a :Obligation ;
    schema:description "Nur in Tankmischung mit 0.1% Folpet 80 WDG (1.6 kg/ha)."@de,
        "Uniquement en mélange avec 0.1% Folpet 80 WDG (1.6 kg/ha)."@fr,
        "Soltanto in combinazione con 0.1% Folpet 80 WDG (1.6 kg/ha)."@it ;
    schema:identifier "13365" .

code:15AA54C8-F122-43E4-8078-AAF3D3232670 a :Obligation ;
    schema:description "Maximal 15 Behandlungen pro Kultur im Abstand von mindestens 5 Tagen."@de,
        "15 traitements au maximum par culture à 5 jours d'intervalle au minimum."@fr,
        "Al massimo 15 trattamenti per coltura a intervalli di almeno 5 giorni l'una dall'altra."@it ;
    schema:identifier "15653" .

code:161A659A-F612-4AC3-8216-6F634571C5D8 a :Obligation ;
    schema:description "Nachfolgearbeiten in behandelten Kulturen sind frühestens 24 Stunden nach Ausbringung möglich. Dabei sind Schutzhandschuhe + Arbeitskleidung (mindestens langärmliges Hemd + lange Hose) zu tragen."@de,
        "Les travaux successifs dans les cultures traitées sont possibles au plus tôt 24 heures après l'application. Il faut alors porter des gants de protection + une tenue de protection (au minimum une chemise à manches longues + des pantalons)."@fr,
        "I lavori successivi nelle colture trattate sono possibili non prima di 24 ore dall'applicazione. È necessario indossare guanti protettivi e indumenti protettivi (almeno camicia a maniche lunghe e pantaloni lunghi)."@it ;
    schema:identifier "15800" .

code:16737B0D-B041-46F7-8717-DD33662B7E95 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung darf dieses oder irgendein anderes Produkt, welches einen Wirkstoff aus der Wirkstoffgruppe der SDHI oder QoI enthält, nicht mehr als 3 mal pro Parzelle und Jahr ausgebracht werden."@de,
        "SPa 1: Pour éviter le développement de résistances, ne pas appliquer ce produit ou tout autre produit du groupe de matières actives SDHI ou QoI plus de 3 fois par parcelle et par année."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenze, effettuare al massimo 3 trattamenti per anno e particella con prodotti contenenti principi attivi del gruppo dei SDHI e dei QoI."@it ;
    schema:identifier "11994" .

code:16C0DBDD-954E-477D-9383-A7BB1F40046E a :Obligation ;
    schema:description "Maximal 3 Behandlungen pro Parzelle und Jahr mit diesem Produkt oder einem anderen Produkt, das den Wirkstoff Tebuconazole enthält."@de,
        "3 traitements au maximum par parcelle et par année avec ce produit ou tout autre produit contenant la substance active tebuconazole."@fr,
        "Al massimo 3 trattamenti per particella e anno con questo prodotto o qualsiasi altro prodotto contenente la sostanza attiva tebuconazolo."@it ;
    schema:identifier "12909" .

code:16DB2682-D121-4A59-8C2F-EFB1E6E6772C a :Obligation ;
    schema:description "Bei Verwendung eines Handspritzgeräts sind Schutzhandschuhe und ein Schutzanzug zu tragen."@de,
        "Lors d'une application avec un appareil à main il est nécessaire de porter des gants et une tenue de protection pour le traitement."@fr,
        "Nel caso si usi un vaporizzatore manuale, indossare indumenti e guanti protettivi."@it ;
    schema:identifier "9747" .

code:16DBE97F-A31F-474A-BA5A-BC62A231B850 a :Obligation ;
    schema:description "Maximal 2 Behandlungen pro Kultur und Jahr im Abstand von 3-4 Wochen."@de,
        "2 traitements au maximum par culture et par année avec un intervalle de 3-4 semaines."@fr,
        "Al massimo 2 trattamenti per coltura e anno ad un intervallo di 3-4 settimane."@it ;
    schema:identifier "15620" .

code:1708B1E8-DD07-4981-BD05-BB993730C773 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung darf dieses oder irgendein anderes Pflanzenschutzmittel, welches ein Pyrethroid enthält, nicht mehr als 1 mal pro Kultur ausgebracht werden."@de,
        "SPa 1: Pour éviter le développement de résistances, ne pas appliquer ce produit ou tout autre contenant une pyréthrinoïde plus de 1 fois par culture."@fr,
        "SPa 1: Per evitare l'insorgere di resistenza non applicare questo o altri prodotti contenenti un piretroide per più di 1 volta per coltura."@it ;
    schema:identifier "11420" .

code:17A0B0C4-03B6-42C7-B03E-7D23C0831C61 a :Obligation ;
    schema:description "Anwendung nur in Kulturen zur Produktion von getrockneten Wurzeln."@de,
        "Application seulement dans des cultures destinées à la production de racines séchées."@fr,
        "Applicazione solamente in colture destinate alla produzione di radici secche."@it ;
    schema:identifier "13800" .

code:17BEA8C4-3A22-48B0-A7C8-8E4CC689A9C4 a :Obligation ;
    schema:description "Maximal 6 kg Kupfer-Metall je Hektar und Jahr; innert 5 aufeinanderfolgender Jahre maximal 20 kg Kupfer-Metall je Hektar (Kupferbilanzierung)."@de,
        "Maximum 6 kg de cuivre métal par année par ha. Le bilan de cuivre métal sur 5 ans ne doit toutefois pas dépasser 20 kg/ha au maximum."@fr,
        "Al massimo 6 kg di rame-metallo per anno e per ettaro. 20 kg di rame-metallo per ettaro (bilancio del rame) nell'arco di 5 anni consecutivi."@it ;
    schema:identifier "9156" .

code:17D91142-F1BA-462D-82F9-CA6AC459352D a :Obligation ;
    schema:description "Notwendige Wartefrist bis zur nachfolgender Bodenbearbeitung oder Saat: 4 Tage."@de,
        "Délai d'attente nécessaire jusqu'au travail du terrain ou jusqu'au semis qui suit: 4 jours."@fr,
        "Termine d'attesa necessario fino alla lavorazione del terreno o alla semina che segue: 4 giorni."@it ;
    schema:identifier "9606" .

code:17E37878-4C45-40F2-916B-FAD1A2EEF08B a :Obligation ;
    schema:description "1-2 Anwendungen pro Jahr im Abstand von 1-4 Wochen ."@de,
        "1-2 applications par année avec un intervalle de 1-4 semaines."@fr,
        "1-2 applicazioni per anno a intervalli di 1-4 settimane."@it ;
    schema:identifier "15649" .

code:17F9F15A-C391-4DC3-A5B1-ED257822F31C a :Obligation ;
    schema:description "Mit Netzmittelzusatz gemäss den Angaben der Bewilligungsinhaberin."@de,
        "Avec adjonction d'un mouillant selon les indications du titulaire de l'autorisation."@fr,
        "Con aggiunta di un umidificante secondo  le indicazioni del titolare dell'autorizzazione."@it ;
    schema:identifier "15144" .

code:181890B6-0A34-41C2-9C61-AAFA0A8DD326 a :Obligation ;
    schema:description "Maximal 3 Behandlungen pro Parzelle und Jahr."@de,
        "3 traitements au maximum par parcelle et par année."@fr,
        "Al massimo 3 trattamenti per anno e particella."@it ;
    schema:identifier "8448" .

code:181F17D4-3D80-43A1-BA61-596716F6D4FB a :Obligation ;
    schema:description "Maximale Gaskonzentration: 128 g/m³ pro Begasung."@de,
        "Concentration maximale de gaz : 128 g/m³ par traitement."@fr,
        "Concentrazion massima di gas: 128 g/m³ per fumigazione."@it ;
    schema:identifier "9834" .

code:1823A008-8BA8-4B83-88A3-AB0BCC4FE368 a :Obligation ;
    schema:description "Entspricht 1.5 Mio Nematoden / Liter; Wasseraufwandmenge von 1250 l/ha."@de,
        "Correspond à 1,5 millions de nématodes / litre; quantité d'eau de 1250 l/ha."@fr,
        "Equivale a 1,5 milioni di nematodi / litro; quantità d'acqua applicata di 1250 l/ha."@it ;
    schema:identifier "15628" .

code:18391B71-723D-4CC2-963A-6CD0C0031FF8 a :Obligation ;
    schema:description "Beim Befüllen des Nebelgeräts sind Schutzhandschuhe, eine Atemschutzmaske (A2P2) und eine dicht abschliessende Schutzbrille oder ein Visier zu tragen."@de,
        "Au moment du remplissage du nébuliseur, porter des gants de protection, un masque de protection (A2P2) et des lunettes de protection étanches ou une visière."@fr,
        "Per riempire il nebulizzatore indossare guanti di protezione, mascherina di protezione delle vie respiratorie (A2P2) e occhiali o visiera di protezione a tenuta stagna."@it ;
    schema:identifier "12944" .

code:185CC06F-6EF7-4912-9BAB-8D14AD10878F a :Obligation ;
    schema:description "Gute Isolation (mindestens 100 m von unbehandelten Beständen)."@de,
        "Veiller à une bonne isolation (respecter une distance de 100 m au moins des peuplements non traités)."@fr,
        "È importante una buona isolazione (almeno 100 m da popolamenti non trattati)."@it ;
    schema:identifier "8316" .

code:18636754-55C3-4072-A4F5-36DF49A5361F a :Obligation ;
    schema:description "Ab 2. Standjahr"@de,
        "Dès la deuxième année de culture."@fr,
        "Dal 2° anno di coltura."@it ;
    schema:identifier "9588" .

code:186A794B-9E78-4807-93FE-B45109DFA52A a :Obligation ;
    schema:description "Anwendung bei sonniger, trockener Witterung; Temperaturen 20-28°C. Nicht anwenden bei bewölkter, kühler Witterung sowie Temperaturen über 28°C."@de,
        "Application par temps ensoleillé et sec ; températures 20-28°C. Ne pas utiliser par temps nuageux et frais ainsi que par des températures supérieures à 28°C."@fr,
        "Utilizzare in tempo soleggiato e secco; temperature 20-28°C. Non utilizzare con tempo nuvoloso, fresco e con temperature superiori ai 28°C."@it ;
    schema:identifier "15283" .

code:188B363B-A5B2-4ECF-A4C0-977C456B6DDA a :Obligation ;
    schema:description "In Tankmischung mit 2.5 - 3 l/ha Chloridazon."@de,
        "En mélange avec 2.5 - 3 l/ha Chloridazon."@fr,
        "In combinazione con 2.5 - 3 l/ha Chloridazon."@it ;
    schema:identifier "9770" .

code:18C55F5A-7B62-40D2-AED0-8BB81887C8ED a :Obligation ;
    schema:description "Die Kultur darf bei der Herbizidbehandlung nicht getroffen werden."@de,
        "La culture ne doit pas être touchée par le traitement herbicide."@fr,
        "Il trattamento erbicida non deve interessare la coltura."@it ;
    schema:identifier "11807" .

code:190AFD1F-E341-457A-9366-44B61F92DA01 a :Obligation ;
    schema:description "Maximal 400ml/ha."@de,
        "400ml/ha au maximum."@fr,
        "400ml/ha al massimo."@it ;
    schema:identifier "15666" .

code:190C16E3-55D4-4378-9EFA-DE447A85ADE6 a :Obligation ;
    schema:description "Maximal 6 Behandlungen; wiederholte Anwendungen im Intervall von 1 Monat."@de,
        "6 traitements par année au maximum; applications répétées à des intervalles de 1 mois."@fr,
        "Al massimo 6 trattamenti; applicazioni ripetute a intervalli di 1 mese."@it ;
    schema:identifier "14843" .

code:1910A4CD-F1FE-4113-A336-3771B836E5FC a :Obligation ;
    schema:description "Zum Zeitpunkt der Behandlung dürfen keine anderen Kulturen als Tomaten im Gewächshaus angebaut werden."@de,
        "Ne pas cultiver simultanément d'autres espèces que des tomates dans la serre."@fr,
        "Nella serra non vi deve essere alcuna coltura oltre ai pomodori."@it ;
    schema:identifier "11424" .

code:1965D30C-25A0-4D4C-B88A-31D019ACE148 a :Obligation ;
    schema:description "Ansetzen der Spritzbrühe: Schutzhandschuhe + Atemschutzmaske (P3) tragen. Ausbringen der Spritzbrühe: Schutzhandschuhe + Schutzanzug + Kopfbedeckung tragen. Technische Schutzvorrichtungen während des Ausbringens (z.B. geschlossene Traktorkabine) können die vorgeschriebene persönliche Schutzausrüstung ersetzen, wenn gewährleistet ist, dass sie einen vergleichbaren oder höheren Schutz bieten."@de,
        "Préparation de la bouillie: Porter des gants de protection + un masque de protection respiratoire (P3). Application de la bouillie: Porter des gants de protection + une tenue de protection + un couvre-chef. Les équipements techniques utilisés lors de l'application (p. ex. cabine de tracteur fermée) peuvent remplacer les équipements personnels de protection s'ils offrent de manière avérée une protection semblable ou supérieure."@fr,
        "Durante la preparazione della poltiglia: Indossare guanti di protezione + una maschera di protezione per le vie respiratore (P3). Applicazione della poltiglia: Indossare guanti di protezione + indumenti protettivi + un copricapo. I dispositivi di protezione individuale possono essere sostituiti, durante l'applicazione, da dispositivi di protezione tecnici (p.es. cabina del trattore chiusa), qualora vi sia la garanzia che offrano una protezione analoga o superiore."@it ;
    schema:identifier "14352" .

code:19729E4D-37D2-458B-879D-4946C983B5B4 a :Obligation ;
    schema:description "Beizung mit Sprühgerät beim Legen."@de,
        "Désinfection avec pulvérisateur pendant la plantation."@fr,
        "Concia con polverizzatore durante la semina."@it ;
    schema:identifier "12144" .

code:19ABB795-D1A6-4937-921D-86A60B4F1A26 a :Obligation ;
    schema:description "Kann bei weichblättrigen Zierpflanzen, Oleander, Farnen und an Blüten Phytotoxschäden verursachen."@de,
        "Sur les plantes d'ornement à feuilles tendres, le laurier-rose, les fougères et sur les fleurs, des dégâts dus à la phytotoxicité peuvent apparaître."@fr,
        "Può causare danni fitotossici su piante ornamentali dalle foglie tenere, su oleandro, felci e fiori."@it ;
    schema:identifier "8229" .

code:19C89EDB-BAB6-46AA-BB7F-CDC4FCB24303 a :Obligation ;
    schema:description "1. Behandlung bei Befallsbeginn, regelmässige Behandlungen in Abständen von 7-10 Tagen."@de,
        "1. application dès le début de l'attaque, répéter le traitement regulièrement tout les 7-10 jours."@fr,
        "1° trattamento all'inizio dell'infestazione, ripetere i trattamenti regolarmente a intervalli di 7 - 10 giorni."@it ;
    schema:identifier "9405" .

code:19D3A8EB-FB91-4954-971F-AAB7C42AEDC5 a :Obligation ;
    schema:description "Berufliche Verwendung: Nachfolgearbeiten in behandelten Kulturen: bis 48 Stunden nach Ausbringung des Mittels Schutzhandschuhe + Schutzanzug tragen."@de,
        "Utilisation professionnelle: Travaux successifs: porter des gants de protection + une tenue de protection jusqu'à 48 heures après l'application du produit."@fr,
        "Utilizzazione professionale: Lavori successivi in colture trattate: indossare guanti + indumenti protettivi fino a 48 ore dall'applicazione del prodotto."@it ;
    schema:identifier "13768" .

code:1A190F4B-12D4-4F55-B6B0-44DF05EFEA7D a :Obligation ;
    schema:description "Keine Anwendung in Beständen mit blühenden Pflanzen."@de,
        "Ne pas utiliser en présence de plantes en fleur."@fr,
        "Non utilizzare in presenza di piante in fiore."@it ;
    schema:identifier "9926" .

code:1A217158-A0B3-4AB9-9A95-1EF448257EBA a :Obligation ;
    schema:description "Nur in Junganlagen."@de,
        "Dans les jeunes plantations uniquement."@fr,
        "Soltanto nelle giovani piantagioni."@it ;
    schema:identifier "14050" .

code:1A8EA669-354B-4110-9688-6D2CBF5F9193 a :Obligation ;
    schema:description "Im Spritztank bei laufendem Rührwerk anwenden. Bei Spritzgeräten ohne Rührwerk Brühe regelmässig schütteln/rühren."@de,
        "Utiliser avec une cuve avec appareil de brassage en marche. Si la cuve n'en dispose pas, agiter ou remuer régulièrement la bouillie."@fr,
        "Impiegare con un serbatoio per la poltiglia con miscelatore in funzione. Per gli apparecchi di irrorazione senza miscelatore agitare/rimescolare la poltiglia regolarmente."@it ;
    schema:identifier "9332" .

code:1AA404D1-7F6C-45B7-974A-B4FD577121B3 a :Obligation ;
    schema:description "Die Luftfeuchtigkeit muss nach dem Einsatz während mindestens 24 Stunden über 90% r. F. gehalten werden."@de,
        "L'humidité atmosphérique relative doit être maintenue à plus de 90% pendant 24 h au moins après le traitement."@fr,
        "Dopo l'intervento occorre mantenere l'umidità atmosferica relativa a oltre il 90%, almeno durante 24 ore."@it ;
    schema:identifier "15406" .

code:1AAA77E4-22C1-45F5-B8A2-158BCD199093 a :Obligation ;
    schema:description "Maximal 12 Behandlungen pro Parzelle und Jahr."@de,
        "12 traitements par parcelle et par année au maximum."@fr,
        "Al massimo 12 trattamentI per anno e particella."@it ;
    schema:identifier "15859" .

code:1ABF56C9-5080-418B-BDE0-765F04FD4E46 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 3 Behandlungen pro Kultur und Jahr mit Produkten aus der Wirkstoffgruppe FRAC Nr.11."@de,
        "SPa 1: Pour éviter le développement de résistances, 3 traitements au maximum par culture et par année avec des produits du groupe de matières actives FRAC N° 11."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 3 trattamenti per anno e coltura con prodotti del gruppo di principi attivi FRAC numero 11."@it ;
    schema:identifier "14411" .

code:1BA3964F-24AE-4D0B-A04F-D84F3C12900F a :Obligation ;
    schema:description "In Tankmischung mit organischen Fungiziden genügt die Hälfte der aufgeführten Konzentration."@de,
        "En mélange avec des fongicides organiques, la moitié de la concentration indiquée suffit."@fr,
        "In combinazione con fungicidi organici è sufficiente la metà della concentrazione indicata."@it ;
    schema:identifier "8343" .

code:1BC0C965-0641-4FE5-94DA-8137D4CAB0D1 a :Obligation ;
    schema:description "Erfahrungsgemäss beste Wirksamkeit in begrenzten Wurzelräumen (Töpfe, Container, Rabatten, Moorbeete, usw.)."@de,
        "L'expérience a montré que la plus grande efficacité est obtenue dans des volumes délimités autour des racines (pots, conteneurs, plates-bandes, lits de tourbe, etc.)."@fr,
        "L'esperienza mostra che l'efficacia migliore si ottiene in spazi limitati per le radici (vasi, container, aiuole, aiuole per piante acidofile, eccetera)."@it ;
    schema:identifier "8221" .

code:1C31B61E-8C02-4E63-B75D-EF271AA126CC a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung maximal 3 Behandlungen pro Parzelle und Jahr mit Produkten aus derselben Wirkstoffgruppe."@de,
        "SPa 1: Pour éviter le développement de résistances 3 traitements au maximum par parcelle et par année avec des produits du même groupe de matières actives."@fr,
        "SPa 1: Per evitare l'insorgenza di resistenza al massimo 3 trattamenti per anno e particella con prodotti dello stesso gruppo di principi attivi."@it ;
    schema:identifier "9591" .

code:1C3A5D19-C10A-460A-BFCA-D23C3146F0C8 a :Obligation ;
    schema:description "Einzelpflanzenbehandlung."@de,
        "Traitement plante par plante."@fr,
        "Trattamento pianta per pianta."@it ;
    schema:identifier "8598" .

code:1C48598C-F178-428A-B124-4D2EF0A0F12C a :Obligation ;
    schema:description "Letzte Behandlung spätestens am 15. September."@de,
        "Dernier traitement au plus tard le 15 septembre."@fr,
        "Ultimo trattamento entro il 15 settembre."@it ;
    schema:identifier "15906" .

code:1C744F6C-3578-4141-A549-03F191931A21 a :Obligation ;
    schema:description "Maximal 5 Behandlungen pro Jahr."@de,
        "5 traitement au maximum par année.."@fr,
        "Al massimo 5 trattamento per anno."@it ;
    schema:identifier "9355" .

code:1C75C32F-09EB-46BE-935F-87BD219F7D1D a :Obligation ;
    schema:description "Befüllen der Maschinen: Schutzanzug tragen. Ausbringen: Schutzhandschuhe + Schutzanzug tragen. Technische Schutzvorrichtungen während des Ausbringens (z.B. geschlossene Traktorkabine) können die vorgeschriebene persönliche Schutzausrüstung ersetzen, wenn gewährleistet ist, dass sie einen vergleichbaren oder höheren Schutz bieten."@de,
        "Lors du remplissage de la machine: Porter une tenue de protection. Application: Porter des gants de protection + une tenue de protection. Les équipements techniques utilisés lors de l'application (p. ex. cabine de tracteur fermée) peuvent remplacer les équipements personnels de protection s'ils offrent de manière avérée une protection semblable ou supérieure."@fr,
        "Durante il riempimento della macchina: Indossare indumenti protettivi. Applicazione: Indossare guanti di protezione + protettivi. I dispositivi di protezione individuale possono essere sostituiti, durante l'applicazione, da dispositivi di protezione tecnici (p.es. cabina del trattore chiusa), qualora vi sia la garanzia che offrano una protezione analoga o superiore."@it ;
    schema:identifier "15610" .

code:1C81D148-17CE-4AD1-8A19-41F518321174 a :Obligation ;
    schema:description "Ansetzen und Ausbringen der Streichlösung: Schutzhandschuhe + Schutzanzug + Schutzbrille oder Visier tragen"@de,
        "Préparation de la bouillie et de l'application au pinceau: porter des gants de protection + une tenue de protection + des lunettes de protection ou une visière."@fr,
        "Preparazione e l'applicazione della poltiglia con il pennello: indossare guanti di protezione + indumenti protettivi + occhiali di protezione o una visiera."@it ;
    schema:identifier "13561" .

code:1CA36809-077A-46F0-B03A-F824474596FE a :Obligation ;
    schema:description "Die Wurzeln vor dem Antreiben besprühen. Falls diese Behandlung durchgeführt wird, darf keine weitere Zugabe zur Lösung erfolgen."@de,
        "Pulvérisation des racines avant le forçage. Si ce traitement est effectué, ne pas ajouter de produit à la solution nutritive."@fr,
        "Irrorazione delle radici prima della forzatura. Se questo trattamento viene effettuato, in seguito non aggiungere più il prodotto alla soluzione nutritiva."@it ;
    schema:identifier "9912" .

code:1CAA5840-AB98-4D81-A6B8-C8840A74822B a :Obligation ;
    schema:description "Maximal 3 Behandlungen pro Parzelle und Jahr im Abstand von 7 Tagen."@de,
        "3 traitements par parcelle et par année au maximum avec un intervalle de 7 jours."@fr,
        "Al massimo 3 trattamenti per anno e particella ad un intervallo di 7 giorni."@it ;
    schema:identifier "13853" .

code:1CB721FE-586B-4864-9597-66A324F21C69 a :Obligation ;
    schema:description "1-3 Splitbehandlungen, 0.5 kg/ha je Split."@de,
        "1-3 traitements fractionnés, 0.5 kg/ha par traitement."@fr,
        "1-3 trattamenti frazionati, 0.5 kg/ha per trattamento."@it ;
    schema:identifier "15602" .

code:1CD2101D-B2DA-4348-AFEB-6FBF3EEEEBF8 a :Obligation ;
    schema:description "SPe 3: Zum Schutz von Gewässerorganismen muss das Abschwemmungsrisiko gemäss den Weisungen der Zulassungsstelle um 2 Punkte reduziert werden."@de,
        "SPe 3: Pour protéger les organismes aquatiques, le risque de ruissellement doit être réduit de 2 points selon les instructions du service d'homologation."@fr,
        "SPe 3: Per proteggere gli organismi acquatici è necessario ridurre il rischio di dilavamento di 2 punti come contemplato nelle istruzioni del Servizio di omologazione."@it ;
    schema:identifier "14121" .

code:1CE858DE-7236-4042-A9EA-388923E7E497 a :Obligation ;
    schema:description "Keine Kompostbehandlung."@de,
        "Traitement du compost interdit."@fr,
        "Nessun trattamento della composta."@it ;
    schema:identifier "8580" .

code:1D1E71F1-B351-4F3A-9E13-A34D7DAB5147 a :Obligation ;
