code:A345BE7D-2CE1-459B-BC71-041ED43E3EAD a :Obligation ;
    schema:description "PLS+RCC = Physiological Leaf Spots und Ramularia collo-cygni."@de,
        "PLS+RCC = Physiological Leaf Spots et Ramularia collo-cygni."@fr,
