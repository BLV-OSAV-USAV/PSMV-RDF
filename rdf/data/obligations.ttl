    schema:identifier "13285" .

code:3EA9F35A-036D-4441-9EDA-402CE832A1E3 a :Obligation ;
    schema:description "Kann Schäden auf Agrostis Arten verursachen."@de,
        "Peut provoquer des dégâts aux espèces de Agrostis."@fr,
