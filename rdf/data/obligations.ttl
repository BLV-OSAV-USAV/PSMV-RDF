code:AE20F4FB-D951-40D8-A84D-071E5F545C03 a :Obligation ;
    schema:description "Nicht bei hoher Sonneneinstrahlung anwenden (frühmorgens oder abends anwenden)."@de,
        "Ne pas appliquer en cas de fort ensoleillement (appliquer le soir ou tôt le matin)."@fr,
        "Utilizzare solo in assenza di radiazione solare elevata (la sera o la mattina presto)."@it ;
    schema:identifier "15640" .

code:AE38CE93-C981-4537-AB8E-D4661BABF94F a :Obligation ;
