code:9782EE23-3232-4501-8323-8E56C2842E8E a :Obligation ;
    schema:description "Konzentration/Aufwandmenge: 0.015 % (0.24 l/ha) \"Rondo Combi L - Slick\" + 0.03 % (0.48 kg/ha) \"Rondo Combi L - Legan\"."@de,
