code:58535C2A-9C72-4FFD-9C27-1DB6650DF3FE a :Obligation ;
    schema:description "Beim Ansetzen und Ausbringen der Spritzbrühe sind Schutzhandschuhe zu tragen."@de,
        "Lors de la préparation et l'application de la bouillie de pulvérisation porter des gants de protection."@fr,
        "Durante la preparazione e l'applicazione della poltiglia è necessario indossare guanti di protezione."@it ;
    schema:identifier "12290" .

code:58825EE5-7997-41E6-A24E-FEC9DD79394E a :Obligation ;
    schema:description "Bei Abschirmung durch die Kultur ist mit einer Wirkungsminderung zu rechnen."@de,
        "La couverture par la culture peut réduire l'efficacité du traitement."@fr,
        "La copertura della coltura può provocare una diminuzione dell'efficaia del trattamento."@it ;
    schema:identifier "12590" .

code:58F3A843-BDEE-425B-BA9E-9903D1D2F0BE a :Obligation ;
    schema:description "Ernte erst im nächsten Jahr."@de,
        "récolte seulement l'année qui suit."@fr,
        "Raccolta solo l'anno che segue."@it ;
    schema:identifier "9581" .

code:58FCDCFB-AE13-4C6F-94DE-DD4170F06F4F a :Obligation ;
    schema:description "Nur in Tankmischung mit einem Glyphosate-Produkt."@de,
        "Uniquement en mélange avec un produit contenant du glyphosate."@fr,
        "Soltanto in combinazione con un prodotto a base di Glifosato."@it ;
    schema:identifier "8486" .

code:5927BD71-7ABE-4B9D-A652-A037530635F7 a :Obligation ;
    schema:description "Überbrausen."@de,
        "Asperger."@fr,
        "Annaffiare."@it ;
    schema:identifier "9677" .

code:5985764E-4C18-4E1D-A862-FEF21F5036FF a :Obligation ;
    schema:description "Die Kultur muss im Zeitpunkt der Behandlung eine gut ausgebildete Wachsschicht aufweisen."@de,
        "Lors du traitement la culture doit avoir une couche de cire bien développée."@fr,
        "Al momento del trattamento la coltura deve avere uno strato di cera ben sviluppato."@it ;
    schema:identifier "14995" .

code:5A136A06-D625-42A5-AB6E-EFE474E81DC2 a :Obligation ;
    schema:description "Maximal 3 Behandlungen."@de,
        "3 traitements au maximum."@fr,
        "Al massimo 3 trattamenti."@it ;
