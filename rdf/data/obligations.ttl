        "Trattamento in estate, dopo un primo taglio, sui ricacci (1 m circa d'altezza) preferibilmente con un vaporizzatore."@it ;
    schema:identifier "13053" .

code:A4B62DE1-4375-4741-BECD-74127F98F6CB a :Obligation ;
