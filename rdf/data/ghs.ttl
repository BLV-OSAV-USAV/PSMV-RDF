code:035BA697-1487-419F-8D8B-FC2524259F1F a ghs:HazardStatement ;
    schema:identifier "EUH032" ;
    schema:name "Entwickelt bei Berührung mit Säure sehr giftige Gase."@de,
        "Contact with acids liberates very toxic gas."@en,
        "Au contact d'un acide, dégage un gaz très toxique."@fr,
        "A contatto con acidi libera gas molto tossici."@it .

code:09E50252-AEBF-4C92-9125-7869DF30C7D8 a ghs:HazardStatement ;
    schema:identifier "H229" ;
    schema:name "Behälter steht unter Druck: Kann bei Erwärmung bersten."@de,
        "Pressurised container: May burst if heated."@en,
        "Récipient sous pression: peut éclater sous l'effet de la chaleur."@fr,
        "Contenitore pressurizzato: può esplodere se riscaldato."@it .

code:1184B376-282F-42DD-82C1-81320EA4F4AB a ghs:HazardStatement ;
    schema:identifier "EUH401" ;
    schema:name "Zur Vermeidung von Risiken für Mensch und Umwelt die Gebrauchsanleitung einhalten."@de,
        "To avoid risks to human health and the environment, comply with the instructions for use."@en,
        "Respectez les instructions d'utilisation pour éviter les risques pour la santé humaine et l'environnement."@fr,
        "Per evitare rischi per la salute umana e per l'ambiente, seguire le istruzioni per l'uso."@it .

code:132E9C76-F989-464D-AE90-FA77F826C314 a ghs:HazardStatement ;
    schema:identifier "H410" ;
    schema:name "Sehr giftig für Wasserorganismen mit langfristiger Wirkung."@de,
        "Very toxic to aquatic life with long lasting effects."@en,
        "Très toxique pour les organismes aquatiques, entraîne des effets néfastes à long terme."@fr,
        "Molto tossico per gli organismi acquatici con effetti di lunga durata."@it .

code:165AAA1A-0C69-4230-9119-BE53811B329C a ghs:HazardPictogram ;
