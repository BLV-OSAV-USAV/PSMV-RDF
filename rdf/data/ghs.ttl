        "Dangereux pour le milieu aquatique"@fr,
        "Pericoloso per l'ambiente acquatico"@it .

code:1774D5E0-D808-4271-A36F-B046EA5A9D59 a ghs:HazardStatement ;
    schema:identifier "EUH066" ;
    schema:name "Wiederholter Kontakt kann zu spröder oder rissiger Haut führen."@de,
        "Repeated exposure may cause skin dryness or cracking."@en,
        "L'exposition répétée peut provoquer dessèchement ou gerçures de la peau."@fr,
        "L'esposizione ripetuta può provocare secchezza o screpolature della pelle."@it .

code:18E274D0-4EB5-46EE-8FA8-3B9BBD2D5418 a ghs:HazardStatement ;
    schema:identifier "H280" ;
    schema:name "Enthält Gas unter Druck; kann bei Erwärmung explodieren."@de,
        "Contains gas under pressure; may explode if heated."@en,
        "Contient un gaz sous pression; peut exploser sous l'effet de la chaleur."@fr,
        "Contiene gas sotto pressione; può esplodere se riscaldato."@it .

code:1ACACCE6-E914-4F44-A528-9A46D04603CE a ghs:HazardPictogram ;
