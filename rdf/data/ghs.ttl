code:380F3945-1615-4EE2-A1BE-7B0DD638940F a ghs:HazardStatement ;
    schema:identifier "H351" ;
    schema:name "Kann vermutlich Krebs erzeugen [Expositionsweg angeben, sofern schlüssig belegt ist, dass diese Gefahr bei keinem anderen Expositionsweg besteht]."@de,
        "Suspected of causing cancer [state route of exposure if it is conclusively proven that no other routes of exposure cause the hazard]."@en,
        "Susceptible de provoquer le cancer [indiquer la voie d’exposition s’il est formellement prouvé qu’aucune autre voie d’exposition ne conduit au même danger]."@fr,
        "Sospettato di provocare il cancro [indicare la via di esposizione se è accertato che nessun'altra via di esposizione comporta il medesimo pericolo]."@it .

code:39BBEE5F-81CD-4129-A661-6F18ADAA1A6D a ghs:HazardStatement ;
    schema:identifier "H360Df" ;
    schema:name "Kann das Kind im Mutterleib schädigen. Kann vermutlich die Fruchtbarkeit beeinträchtigen."@de,
        "Peut nuire au foetus. Susceptible de nuire à la fertilité."@fr,
        "Può nuocere al feto. Sospettato di nuocere alla fertilità."@it .

code:39CACF0F-90AC-4D0E-B2D5-173A0E1A1F29 a ghs:HazardStatement ;
    schema:identifier "H206" ;
    schema:name "Gefahr durch Feuer, Druckstoß oder Sprengstücke; erhöhte Explosionsgefahr, wenn das Desensibilisierungsmittel reduziert wird."@de,
        "Fire, blast or projection hazard; increased risk of explosion if desensitising agent is reduced."@en,
        "Danger d'incendie, d'effet de souffle ou de projection; risque accru d'explosion si la quantité d'agent désensibilisateur est réduite."@fr,
        "Pericolo d'incendio, di spostamento d'aria o di proiezione; maggior rischio di esplosione se l'agente desensibilizzante è ridotto."@it .

code:3A139718-C859-411F-AEDE-E661C18CD958 a ghs:HazardStatement ;
    schema:identifier "H334" ;
    schema:name "Kann bei Einatmen Allergie, asthmaartige Symptome oder Atembeschwerden verursachen."@de,
        "May cause allergy or asthma symptoms or breathing difficulties if inhaled."@en,
        "Peut provoquer des symptômes allergiques ou d'asthme ou des difficultés respiratoires par"@fr,
        "Può provocare sintomi allergici o asmatici o difficoltà respiratorie se inalato."@it .

code:3C2B6132-0E3F-45EA-9255-014811142D18 a ghs:HazardStatement ;
    schema:identifier "EUH211" ;
    schema:name "Achtung! Beim Sprühen können gefährliche lungengängige Tröpfchen entstehen. Aerosol oder Nebel nicht einatmen."@de,
        "Warning! Hazardous respirable droplets may be formed when sprayed. Do not breathe spray or mist."@en,
        "Attention! Des gouttelettes respirables dangereuses peuvent se former lors de la pulvérisation. Ne pas respirer les aérosols ni les brouillards."@fr,
        "Attenzione! In caso di vaporizzazione possono formarsi goccioline respirabili pericolose. Non respirare i vapori o le nebbie."@it .

code:4655E2A6-4727-47E9-9E73-F7A907A832BB a ghs:PrecautionaryStatement ;
    schema:name "Vorsicht! Beim Entzünden der Patrone entsteht giftiges Gas (Schwefeldioxid)."@de,
        "Attention! Après l'allumage, la cartouche produit du gaz toxique (dioxyde de soufre)."@fr,
        "Attenzione! All'accensione la cartuccia rilascia gas tossico (anidride solforosa)."@it .

code:48B1EE0D-9E73-4219-AC33-DA527BE86BAD a ghs:HazardStatement ;
    schema:identifier "EUH014" ;
    schema:name "Reagiert heftig mit Wasser."@de,
        "Reacts violently with water."@en,
        "Réagit violemment au contact de l'eau."@fr,
        "Reagisce violentemente con l'acqua."@it .

code:49DD67A9-80BE-4256-B6D9-638746DCCBFF a ghs:PrecautionaryStatement ;
    schema:identifier "SPo 4" ;
    schema:name "Der Behälter muss im Freien und Trockenen geöffnet werden."@de,
        "L'emballage doit être ouvert à l'extérieur par temps sec."@fr,
        "L'imballaggio deve essere aperto all'esterno e in condizioni di tempo secco."@it .

code:54C4FEDF-3D24-4E4F-9168-92D5AB072B72 a ghs:HazardStatement ;
    schema:identifier "H361d" ;
    schema:name "Kann vermutlich das Kind im Mutterleib schädigen."@de,
        "Suspected of damaging the unborn child."@en,
        "Susceptible de nuire au foetus."@fr,
        "Sospettato di nuocere al feto."@it .

code:54CFB3C1-E4BC-4E59-9A7D-3A46D4D3D360 a ghs:HazardPictogram ;
    schema:identifier "GHS05" ;
    schema:name "Ätzend"@de,
