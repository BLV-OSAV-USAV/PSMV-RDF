code:80EB3D2B-D2C2-4A2C-B97C-FB694CA968C0 a ghs:HazardStatement ;
    schema:identifier "EUH208" ;
    schema:name "Enthält [Name des sensibilisierenden Stoffes]. Kann allergische Reaktionen hervorrufen."@de,
