code:30A90536-9EDF-4353-8AC0-97DBC4B3E9C2 a ghs:PrecautionaryStatement ;
    schema:identifier "SPe 6" ;
    schema:name "Zum Schutz von Vögeln und wildlebenden Säugetieren muss das verschüttete Pflanzenschutzmittel beseitigt werden."@de,
        "Pour protéger les oiseaux et les mammifères sauvages, récupérer tout produit phytosanitaire accidentellement répandu."@fr,
        "Per proteggere gli uccelli e i mammiferi selvatici recuperare il prodotto fuoriuscito accidentalmente."@it .

code:317A868D-9B43-4F76-96BE-021C87E34BDE a ghs:HazardStatement ;
