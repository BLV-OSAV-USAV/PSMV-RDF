        "May be corrosive to metals."@en,
        "Peut être corrosif pour les métaux."@fr,
        "Può essere corrosivo per i metalli."@it .

code:35AA52AA-FC8A-4908-B997-18DC1E140409 a ghs:PrecautionaryStatement ;
    schema:identifier "SP 1" ;
    schema:name "Mittel und/oder dessen Behälter nicht in Gewässer gelangen lassen."@de,
