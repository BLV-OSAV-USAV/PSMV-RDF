code:567D8F4D-A916-4220-B471-B93C03369597 a ghs:HazardStatement ;
    schema:identifier "H300 + H310" ;
    schema:name "Lebensgefahr bei Verschlucken oder Hautkontakt."@de,
        "Fatal if swallowed or in contact with skin."@en,
        "Mortel par ingestion ou par contact cutané."@fr,
        "Mortale in caso di ingestione o a contatto con la pelle."@it .

code:599209A6-9319-4070-8352-A4A9EFDEF1DD a ghs:PrecautionaryStatement ;
    schema:name "Aerosol nicht einatmen."@de,
        "Ne pas respirer les aérosols."@fr,
        "Non respirare i aerosoli."@it .

code:5B1BB1AE-9DEB-438B-B3F3-C185BFA8D26D a ghs:PrecautionaryStatement ;
    schema:identifier "Spe 1" ;
    schema:name "Zum Schutz von Bodenorganismen dieses Pflanzenschutzmittel nicht mehr als 4 mal pro Parzelle und Jahr anwenden."@de,
        "Pour protéger les organismes du sol, ne pas appliquer ce produit plus de 4 fois par parcelle et par année."@fr,
        "Per proteggere gli organismi del suolo non applicare questo prodotto più di 4 volte per anno e particella."@it .

code:6094C6A1-7B43-45CA-BA33-0264C6E458E7 a ghs:HazardStatement ;
    schema:identifier "H335" ;
    schema:name "Kann die Atemwege reizen."@de,
        "May cause respiratory irritation."@en,
        "Peut irriter les voies respiratoires."@fr,
        "Può irritare le vie respiratorie."@it .

code:626C4F0F-1B3B-44EE-BDF2-995AD5BDE4B4 a ghs:HazardStatement ;
    schema:identifier "H400" ;
    schema:name "Sehr giftig für Wasserorganismen."@de,
        "Very toxic to aquatic life."@en,
        "Très toxique pour les organismes aquatiques."@fr,
        "Molto tossico per gli organismi acquatici."@it .

code:651C1897-53AC-4DE0-A5E0-41A7CC2BF250 a ghs:HazardStatement ;
    schema:identifier "H411" ;
    schema:name "Giftig für Wasserorganismen, mit langfristiger Wirkung."@de,
        "Toxic to aquatic life with long lasting effects."@en,
        "Toxique pour les organismes aquatiques, entraîne des effets néfastes à long terme."@fr,
        "Tossico per gli organismi acquatici con effetti di lunga durata."@it .

code:65D212F1-CCEE-4430-86D9-2B68F59200C3 a ghs:PrecautionaryStatement ;
    schema:identifier "SPo 5" ;
    schema:name "Bei der Anwendung in einem geschlossenen Raum (z.B. Gewächshaus) ist der behandelte Raum vor dem Wiederbetreten [gründlich / oder Zeit angeben / bis zur Abtrocknung des Spritzbelages] zu lüften."@de,
        "En cas d'utilisation dans un endroit confiné, ventiler [à fond / ou durée à préciser / jusqu'au séchage de la pulvérisation] les zones / serres traitées avant d'y accéder."@fr,
        "In caso di utilizzazione in un ambiente chiuso (p.es. serra), arieggiare [a lungo / per ... durata da specificare / fino all'essiccazione dello spray] gli ambienti trattati prima di potervi accedere nuovamente."@it .

code:666B6894-016F-40C5-BAFE-8D8D5CD368E0 a ghs:HazardStatement ;
    schema:identifier "H318" ;
    schema:name "Verursacht schwere Augenschäden."@de,
        "Causes serious eye damage."@en,
        "Provoque des lésions oculaires graves."@fr,
        "Provoca gravi lesioni oculari."@it .

code:68949557-A43A-4019-B106-0E4E95EBB3D1 a ghs:HazardStatement ;
    schema:identifier "H373" ;
    schema:name "Kann die Organe schädigen [alle betroffenen Organe nennen, sofern bekannt] bei längerer oder wiederholter Exposition [Expositionsweg angeben, wenn schlüssig belegt ist, dass diese Gefahr bei keinem anderen Expositionsweg besteht]."@de,
        "May cause damage to organs [or state all organs affected, if known] through prolonged or repeated exposure [state route of exposure if it is conclusively proven that no other routes of exposure cause the hazard]."@en,
        "Risque présumé d'effets graves pour les organes [indiquer tous les organes affectés…] à la suite d'expositions répétées ou d'une exposition prolongée [indiquer la voie d'exposition … qu'aucune autre voie d'exposition ne conduit au même danger]."@fr,
        "Può provocare danni agli organi [o indicare tutti gli organi interessati, se noti] in caso di esposizione prolungata o ripetuta [indicare la via di esposizione se è accertato che nessun'altra via di esposizione comporta il medesimo pericolo]."@it .

code:6A4961DF-073D-44BD-AAF5-643C519E0598 a ghs:HazardStatement ;
    schema:identifier "EUH032" ;
    schema:name "Entwickelt bei Berührung mit Säure sehr giftige Gase."@de,
        "Contact with acids liberates very toxic gas."@en,
        "Au contact d'un acide, dégage un gaz très toxique."@fr,
        "A contatto con acidi libera gas molto tossici."@it .

code:6E786A81-F8E2-48C7-B918-CD8845852D93 a ghs:HazardStatement ;
    schema:identifier "H372" ;
    schema:name "Schädigt die Organe bei längerer oder wiederholter Exposition."@de,
        "Causes damage to organs through prolonged or repeated exposure."@en,
        "Risque avéré d'effets graves pour les organes à la suite d'expositions répétées ou d'une exposition prolongée."@fr,
        "Provoca danni agli organi in caso di esposizione prolungata o ripetuta."@it .

code:72A5D2DE-3CFB-4A9D-A718-5F4A0235F5E0 a ghs:PrecautionaryStatement ;
    schema:identifier "SPr 1" ;
    schema:name "Die Köder verdeckt und unzugänglich für andere Tiere ausbringen. Köder sichern, so dass ein Verschleppen durch Nagetiere nicht möglich ist."@de,
        "Les appâts doivent être disposés de manière à minimiser le risque d'ingestion par d'autres animaux. Sécuriser les appâts afin qu'ils ne puissent pas être emmenés par les rongeurs."@fr,
        "Le esche devono essere disposte in modo da minimizzare il rischio di ingerimento da parte di altri animali. Fissare le esche in modo che non possano essere trascinate via dai roditori."@it .

code:7DB4F6BC-8CCD-4D50-97BE-9CF716E32827 a ghs:HazardPictogram ;
