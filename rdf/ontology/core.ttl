# ==============================================================================
# PREFIXES
# ==============================================================================

# Project-specific QNames ------------------------------------------------------
@prefix : <https://agriculture.ld.admin.ch/plant-protection/> .
@prefix ghs: <https://agriculture.ld.admin.ch/plant-protection/ghs/> .

# General prefixes -------------------------------------------------------------
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# ONTOLOGY METADATA
# ------------------------------------------------------------------------------
# Use <https://semver.org/> as a reference for version number
# ==============================================================================

: a owl:Ontology ;
    dcterms:creator "Martin Hertach",
        "Ingrid Nyfeler",
        "Damian Oswald",
        "Sara Schärrer",
        "Guy Schnidrig" ;
    dcterms:title "Crop protection product ontology"@en ;
    owl:versionInfo "3.0.0" .

# ==============================================================================
# CORE PHYTOSANITARY CLASSES & PROPERTIES
# ==============================================================================

:Crop a owl:Class ;
    schema:name "Crop"@en,
        "Kultur"@de .

:Pest a owl:Class ;
    schema:name "Pest"@en .

:ApplicationComment a owl:Class ;
    schema:name "Application comments"@en , "Anwendungskommentar"@de ;
    schema:description "Comments on how the product must be applied (dosage, etc.)"@en .

:Obligation a owl:Class ;
    schema:name "Obligation"@en .

:ApplicationArea a owl:Class ;
    schema:name "Application Area"@en .

:applicationArea a owl:ObjectProperty ;
    schema:name "Application area"@en ;
    rdfs:domain :Indication ;
    rdfs:range :ApplicationArea .

# ==============================================================================
# PERMISSION HOLDERS
# ==============================================================================

schema:Organization a owl:Class ;
    schema:name "Organization"@en,
        "Organisation"@de ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty schema:legalName ;
        owl:allValuesFrom xsd:string ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:address ;
        owl:allValuesFrom schema:PostalAddress ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:telephone ;
        owl:allValuesFrom xsd:string ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:faxNumber ;
        owl:allValuesFrom xsd:string ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:email ;
        owl:allValuesFrom xsd:string ;
    ] .

schema:PostalAddress a owl:Class ;
    schema:name "Address"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty schema:addressCountry ;
        owl:allValuesFrom schema:Country ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:streetAddress ;
        owl:allValuesFrom xsd:string ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:postalCode ;
        owl:allValuesFrom xsd:string ;
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty schema:addressLocality ;
        owl:allValuesFrom xsd:string ;
    ].

# ==============================================================================
# PRODUCT TAXONOMY AND PROPERTIES (Herbicides, Insecticides etc.)
# ==============================================================================

# Product class and product-specific properties --------------------------------

:Product a owl:Class ;
    schema:name "Product"@en ;
    schema:description "Represents any plant protection product that is officially registered and listed on <https://psm.admin.ch/>."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty schema:countryOfOrigin ;
        owl:allValuesFrom schema:Country ;
    ] .

:RegularProduct a owl:Class ;
    rdfs:subClassOf :Product ;
    schema:name "Regular product"@en ;
    schema:name "Reguläre Produkte"@de ;
    schema:description "Products with Swiss marketing authorization holders that have been approved in Switzerland."@en ;
    schema:description "Produkte mit Schweizer Zulassungsinhaber, die in der Schweiz zugelassen wurden."@de .

:SalePermission a owl:Class ;
    rdfs:subClassOf :Product ;
    schema:name "Sale Permission"@en ;
    schema:name "Verkaufserlaubnisse"@de ;
    schema:description "Marketing authorization holders may grant other companies permission to sell a product. This is assessed and approved by the marketing authorization authority. The originally approved product is referred to as the reference product. All information in the plant protection product directory for sales permits, except for the product name, authorization numbers, and authorization holders, is taken from the reference product. In the case of sales permits, individual applications of the reference product may be withdrawn (i.e., not all applications of the reference product are necessarily valid for the sales permit)."@en ;
    schema:description "Zulassungsinhaber können anderen Firmen eine Verkaufserlaubnis eines Produkts erteilen. Diese wird von der Zulassungsstelle beurteilt und bewilligt. Das ursprünglich bewilligte Produkt wird als Referenzprodukt bezeichnet. Alle Angaben im Pflanzenschutzmittelverzeichnis für Verkaufserlaubnisse ausser Produktname, Zulassungsnummern und Zulassungsinhaber werden vom Referenzprodukt bezogen. Im Falle der Verkaufserlaubnisse können einzelne Anwendungen des Referenzprodukts zurückgezogen werden (d.h. es sind nicht zwingend alle Anwendungen des Referenzprodukts für die Verkaufserlaubnis gültig)."@de .

:ParallelImport a owl:Class ;
    rdfs:subClassOf :Product ;
    schema:name "Parallel Import"@en ;
    schema:name "Parallelimporte"@de ;
    schema:description "Products with a foreign holder of the marketing authorization for which an equivalent regular product (in terms of chemical composition and formulation) exists. This product is referred to as the reference product. All information in the plant protection product directory for parallel imports, except for the product name, authorization numbers, and authorization holder, is taken from the reference product. The same applications apply to parallel imports as to the reference product."@en ;
    schema:description "Produkte mit einer ausländischen Zulassungsinhaberin, für die ein äquivalentes Reguläres Produkt (bezüglich chemischer Zusammensetzung und Formulierung) existiert. Dieses Produkt wird als Referenzprodukt bezeichnet. Alle Angaben im Pflanzenschutzmittelverzeichnis für Parallelimporte ausser Produktname, Zulassungsnummern und Zulassungsinhaber werden vom Referenzprodukt bezogen. Für den Parallelimport gelten die gleichen Anwendungen wir für das Referenzprodukt."@de .

# Logical statement: All subclasses based on permissions are disjoint from each other
[] a owl:AllDisjointClasses ;
    owl:members (
        :RegularProduct
        :SalePermission
        :ParallelImport
    ) .

:ghs a owl:ObjectProperty ;
    schema:name "GHS statement"@en ;
    rdfs:domain :Product ;
    rdfs:range ghs:GHSStatement .

:indication a owl:ObjectProperty ;
    schema:name "has indications"@en ;
    rdfs:domain :Product ;
    rdfs:range :Indication .

:ingredient a owl:ObjectProperty ;
    schema:name "Ingredient"@en ;
    rdfs:domain :Product ;
    rdfs:range :Ingredient .

:federalAdmissionNumber a owl:DatatypeProperty, owl:FunctionalDataProperty ;
    schema:name "Eidgenössische Zulassungsnummer"@de,
        "Federal admission number"@en ;
    schema:description "The federal admission number uniquely identifies a product registration. It is either constructed as a W-Number in the case of federal admissions (e.g., W-18) or as a parallel import number with the country of origin's initial letter in the code in the case of parallel imports (e.g., I-2789 for a parallel import from Italy). Numbers with a dash (e.g., W-18-1, W-18-2) represent equivalent products held by different legal entities, while numbers without a dash (e.g., W-18) represent the original registration."@en ;
    rdfs:subPropertyOf schema:identifier ;
    rdfs:domain :Product ;
    rdfs:range xsd:NCName .

:referenceProduct a owl:ObjectProperty ;
    schema:name "Referenzprodukt"@de,
        "Reference product"@en ;
    rdfs:range :Product ;
    rdfs:domain :Product .

:foreignAdmissionNumber a owl:DatatypeProperty ;
    schema:name "Ausländische Zulassungsnummer"@de,
        "Foreign admission number"@en ;
    rdfs:subPropertyOf schema:identifier ;
    rdfs:domain :ParallelImport ;
    rdfs:range xsd:NCName .

:packageInsertNumber a owl:DatatypeProperty ;
    schema:name "Packungsbeilagenummer"@de,
        "Package insert number"@en ;
    rdfs:subPropertyOf schema:identifier ;
    rdfs:domain :Product ;
    rdfs:range xsd:string .

:permissionHolder a owl:ObjectProperty ;
    schema:name "Permission holder"@en ;
    rdfs:domain :Product ;
    rdfs:range schema:Organization .

:exhaustionDeadline a owl:DatatypeProperty ;
    schema:name "Ablaufdatum der Nutzung"@de,
        "Exhaustion deadline"@en ;
    schema:description "The date by which the product must no longer be used, typically after the product registration has been revoked."@en ;
    rdfs:domain :Product ;
    rdfs:range xsd:date .

:soldOutDeadline a owl:DatatypeProperty ;
    schema:name "Ausverkauft-Frist"@de,
        "Sold out deadline"@en ;
    schema:description "The date by which the product can no longer be sold, typically after the product registration has been revoked."@en ;
    rdfs:domain :Product ;
    rdfs:range xsd:date .

# ==============================================================================
# INDICATION CLASS DEFINITION AND PROPERTIES
# ==============================================================================

:Indication a owl:Class ;
    schema:name "Indication"@en ;
    schema:alternateName "Application"@en .

:pest a owl:ObjectProperty ;
    schema:name "allowed against pests"@en ;
    rdfs:domain :Indication ;
    rdfs:range :Pest .

:cultivation a owl:ObjectProperty ;
    schema:name "allowed on cultivations"@en ;
    rdfs:domain :Indication ;
    rdfs:range :Cultivation .

:obligation a owl:ObjectProperty ;
    schema:name "Obligation"@en ;
    rdfs:domain :Indication ;
    rdfs:range :Obligation .

:applicationComment a owl:ObjectProperty ;
    schema:name "Application Comment"@en ;
    rdfs:domain :Indication ;
    rdfs:range :ApplicationComment .

:dosage a owl:DatatypeProperty ;
    schema:name "Dosierung"@de,
        "Dosage"@en ;
    rdfs:domain :Indication ;
    rdfs:range schema:QuantitativeValue .

:expenditure a owl:DatatypeProperty ;
    schema:name "Ausbringungsmenge"@de,
        "Expenditure"@en ;
    rdfs:domain :Indication ;
    rdfs:range schema:QuantitativeValue .

:waitingPeriod a owl:DatatypeProperty ;
    schema:name "Wartezeit"@de,
        "Waiting period"@en ;
    schema:description "The required time interval after a treatment during which the same product should not be applied again to the same crop."@en ;
    rdfs:domain :Indication ;
    rdfs:range schema:QuantitativeValue .

# ==============================================================================
# INGREDIENTS AND SUBSTANCES
# ==============================================================================

:Ingredient a owl:Class ;
    schema:name "Ingredient"@en ;
    schema:description "A composition entry linking a product to a substance with a specified concentration."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :substance ;
        owl:someValuesFrom :Substance
    ], [
        a owl:Restriction ;
        owl:onProperty :concentration ;
        owl:allValuesFrom schema:QuantitativeValue
    ] .

:Substance a owl:Class ;
    schema:name "Substance"@en .

:ActiveSubstance a owl:Class ;
    rdfs:subClassOf :Substance ;
    schema:name "Active Substance"@en ;
    schema:description "A biologically active ingredient in a plant protection product that acts against pests or diseases."@en .

:CoFormulant a owl:Class ;
    rdfs:subClassOf :Substance ;
    schema:name "Co-formulant"@en ;
    schema:description "An inactive ingredient in a plant protection product that supports the formulation but has no direct pesticidal activity."@en .

:substance a owl:ObjectProperty ;
    schema:name "Has Substance"@en ;
    rdfs:domain :Ingredient ;
    rdfs:range :Substance .

:concentration a owl:ObjectProperty ;
    schema:name "Concentration"@en ;
    rdfs:domain :Ingredient ;
    rdfs:range schema:QuantitativeValue .

:hasIngredient a owl:ObjectProperty ;
    schema:name "Has Ingredient"@en ;
    rdfs:domain :Product ;
    rdfs:range :Ingredient .


:iupacName a owl:DatatypeProperty ;
    schema:name "IUPAC Name"@en ;
    rdfs:domain :Substance ;
    rdfs:range xsd:string .

schema:QuantitativeValue a owl:Class ;
    schema:name "Quantitative value"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty schema:value ;
        owl:allValuesFrom xsd:decimal
    ], [
        a owl:Restriction ;
        owl:onProperty schema:maxValue ;
        owl:allValuesFrom xsd:decimal
    ], [
        a owl:Restriction ;
        owl:onProperty schema:minValue ;
        owl:allValuesFrom xsd:decimal
    ], [
        a owl:Restriction ;
        owl:onProperty schema:unitCode ;
        owl:allValuesFrom qudt:Unit
    ], [
        a owl:Restriction ;
        owl:onProperty schema:name ;
        owl:allValuesFrom xsd:string
    ] .

# ==============================================================================
# PROPERTIES
# ==============================================================================

schema:legalName rdfs:subPropertyOf schema:name .

:productType rdfs:subPropertyOf rdf:type .