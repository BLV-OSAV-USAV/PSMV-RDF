@prefix : <https://agriculture.ld.admin.ch/plant-protection/> .
@prefix country: <https://ld.admin.ch/country/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://agriculture.ld.admin.ch/plant-protection/shape/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:Product a sh:NodeShape ;
    sh:name "Product"@en ;
    sh:targetClass :Product ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@en ;
        sh:description "Name of the product"@en ;
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 2 ;
        sh:name "Federal admission number"@en ;
        sh:description "An identifier assigned by the FSVO that uniquely identifies an admissions of a plant protection product."@en ;
        sh:path :federalAdmissionNumber ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]-[0-9]{4}(-[0-9]{1,2})?$" ;
        sh:message "The federal admission number must match the pattern 'L-DDDD' or 'L-DDDD-D', where L is an uppercase letter and D a digit."@en ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 3 ;
        sh:name "Foreign admission number"@en ;
        sh:description "An identifier assigned by any foreign authority."@en ;
        sh:path :foreignAdmissionNumber ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:name "Ingredient"@en ;
        sh:path :ingredient ;
        sh:node shape:Ingredient ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:name "Permission holder"@en ;
        sh:path :permissionHolder ;
        sh:node shape:Organization ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "GHS code"@en ;
        sh:path :ghs ;
        sh:node shape:GHSStatement ;
    ] ;
    sh:property [
        sh:name "Producing country"@en ;
        sh:description "The country where a plant protection product was produced."@en ;
        sh:path :producingCountry ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( country:CHE country:DEU country:ITA country:FRA country:AUT country:BEL country:LIE country:DDR country:BDI country:BEN country:CAF country:ZR0 country:COD country:BHR country:KWT country:OMN country:QAT country:AFG country:TUV country:1A0 country:WSM country:SLB country:DNK country:GBR country:GRC country:HRV country:HUN country:LTU country:MEX country:NLD country:POL country:PRT country:SWE country:BGR country:CYP country:ESP country:IRL country:MAR country:MLT country:MYS country:CZE country:EST country:FIN country:LVA country:SVK country:SVN country:LUX country:ROU country:VNM country:SEN country:SYC country:ZAF country:KOR country:LBN country:SAU country:JOR country:COM country:PAK country:TUN country:MKD country:GNQ country:AUS country:GIN country:DZA country:TKM country:IRN country:ARG country:EGY country:IDN country:CHL country:BGD country:URY country:MUS country:BLZ country:BRB country:CIV country:COG country:GUY country:JAM country:KEN country:MDG country:MWI country:SUR country:SWZ country:TTO country:TZA country:UGA country:ZMB country:ZWE country:KGZ country:MRT country:SLE country:GMB country:LBY country:PAN country:AND country:NOR country:RUS country:SMR country:STP country:TUR country:ISL country:GNB country:CHN country:NPL country:USA country:ISR country:JPN country:CAN country:YUG country:BIH country:SCG country:IND country:MDA country:KNA country:MCO country:TCD country:VUT country:LAO country:MLI country:TGO country:BRN country:COL country:PNG country:SUN country:TJK country:THA country:BRA country:NZL country:CPV country:NER country:UZB country:MOZ country:TWN country:GTM country:BLR country:LKA country:FSM country:CSK country:BHS country:ARM country:DMA country:EUR country:ALB country:BFA country:KAZ country:UKR country:SGP country:CMR country:AGO country:ARE country:GEO country:DOM country:ATG country:BOL country:CRI country:CUB country:ECU country:GRD country:HTI country:LCA country:NIC country:PER country:PRY country:SLV country:VCT country:VEN country:SOM country:FJI country:HKG country:PLW country:MNG country:SRB country:MNE country:SYR country:GAB country:HND country:LBR country:PHL country:MDV country:MAC country:RWA country:AZE country:KIR country:SDN country:GHA country:YMD country:YEM country:BWA country:LSO country:NAM country:VAT country:IRQ country:NGA country:DJI country:KHM country:TLS country:TON country:PSE country:BYS country:MHL country:AFI country:ATA country:BTN country:BUR country:MMR country:CTE country:DHY country:ERI country:ESH country:ETH country:FXX country:GEL country:GGY country:HVO country:IMN country:JEY country:JTN country:MID country:NHB country:NRU country:PCZ country:PRK country:PUS country:RHO country:SKM country:SSD country:TMP country:VDR country:WAK country:GRL country:CYM country:BMU country:GIB country:ABW country:ANT country:BES country:CUW country:SXM country:FRO country:COK country:AIA country:ALA country:ASM country:ATB country:ATF country:FQ0 country:ATN country:BLM country:BVT country:CCK country:CPT country:CXR country:FLK country:GLP country:GUF country:GUM country:HMD country:IOT country:MAF country:MNP country:MSR country:MTQ country:MYT country:NCL country:NFK country:NIU country:PCI country:PCN country:PRI country:PYF country:REU country:SGS country:SHN country:SJM country:SPM country:TCA country:TKL country:UMI country:VGB country:VIR country:WLF country:XKX country:ZAR ) ;
    ] .

shape:Ingredient a sh:NodeShape ;
    sh:property [
        schema:name "Substance"@en ;
        sh:path :substance ;
        sh:class :Substance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        schema:name "Share (Quantitative Value)"@en ;
        sh:path :share ;
        sh:node shape:Share ;
        sh:minCount 1 ;
    ] .

shape:QuantitativeValue a sh:NodeShape ;
    sh:targetClass schema:QuantitativeValue ;
    sh:property [
        sh:name "Value"@en ;
        sh:path schema:value ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ingredient share value must be strictly greater than 0."@en ;
    ] ;
    sh:property [
        schema:name "Unit validation"@en ;
        sh:path schema:unitCode ;
        sh:in ( unit:PERCENT unit:GM-PER-L ) ; 
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The unit must be either % or g/l represented as a `qudt:Unit`."@en ;
    ] .

shape:Organization a sh:NodeShape ;
  sh:targetClass schema:Organization ;
  sh:property [
    schema:name "Legal name required"@en ;
    sh:path schema:legalName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] .
