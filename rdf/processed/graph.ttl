        "Utiliser des outils ne produisant pas d'étincelles"@fr,
        "Utilizzare utensili antiscintillamento"@it .

ghs:P243 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P243" ;
    schema:name "Maßnahmen gegen elektrostatische Entladungen treffen"@de,
        "Take precautionary measures against static discharge."@en,
        "Prendre des mesures de précaution contre les décharges électrostatiques"@fr,
        "Fare in modo di prevenire le scariche elettrostatiche"@it .

ghs:P244 a ghs:GHSStatement,
