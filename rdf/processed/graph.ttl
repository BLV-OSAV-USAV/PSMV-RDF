    schema:name "BEI KONTAKT MIT DEN AUGEN:"@de,
        "IF IN EYES:"@en,
        "EN CAS DE CONTACT AVEC LES YEUX:"@fr,
        "IN CASO DI CONTATTO CON GLI OCCHI:"@it .

ghs:P305P351P338 a _:nb5d4b645a8d94404ba4f47a2b145e43cb1,
