    schema:identifier "15290" .

code:B96934E3-3EEA-43CC-8527-B2CAB431916F a :Obligation ;
    schema:description "Mit 100 l Wasser."@de,
        "Avec 100 l d'eau."@fr,
        "Con 100 l d'acqua."@it ;
    schema:identifier "9667" .

code:B97E51B6-E8DE-4440-A222-8FE010015E01 a :Obligation ;
    schema:description "SPa 1: Zur Vermeidung einer Resistenzbildung dürfen Pflanzenschutzmittel aus der gleichen Wirkstoffgruppe nicht mehr als 2 mal pro Kultur ausgebracht werden."@de,
        "SPa 1: Pour éviter le développement de résistances, ne pas appliquer produits du même groupe de matières actives plus de 2 fois par culture."@fr,
        "SPa 1: Per evitare l'insorgere di resistenza non applicare prodotti dello stesso gruppo di principi attivi per più di 2 volte per coltura."@it ;
