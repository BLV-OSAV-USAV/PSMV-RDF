    schema:identifier "P402+P404" ;
    schema:name "An einem trockenen Ort aufbewahren. In einem geschlossenen Behälter aufbewahren"@de,
        "Store in a dry place. Store in a closed container"@en,
        "Stocker dans un endroit sec. Stocker dans un récipient fermé"@fr,
        "Conservare in luogo asciutto e in recipiente chiuso"@it .

ghs:P403 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P403" ;
    schema:name "An einem gut belüfteten Ort aufbewahren"@de,
        "Store in a well-ventilated place"@en,
        "Stocker dans un endroit bien ventilé"@fr,
        "Conservare in luogo ben ventilato"@it .

ghs:P403P233 a ghs:GHSStatement,
