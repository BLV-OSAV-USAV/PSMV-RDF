code:69B09CDB-D529-43E0-A1D4-1056F65042FE a :Obligation ;
    schema:description "Maximal 2 Behandlungen pro Kultur und Jahr."@de,
        "2 traitements au maximum par culture et par année."@fr,
        "Al massimo 2 trattamenti per coltura e anno."@it ;
