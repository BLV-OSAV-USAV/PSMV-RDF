        "Rischio di esplosione. Utilizzare i mezzi estinguenti a grande distanza"@it .

ghs:P376 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P376" ;
    schema:name "Undichtigkeit beseitigen, wenn gefahrlos möglich"@de,
        "Stop leak if safe to do so"@en,
        "Obturer la fuite si cela peut se faire sans danger"@fr,
        "Bloccare la perdita se non c’è pericolo"@it .

ghs:P377 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P377" ;
    schema:name "Brand von ausströmendem Gas: Nicht löschen, bis Undichtigkeit gefahrlos beseitigt werden kann"@de,
        "Leaking gas fire: Do not extinguish, unless leak can be stopped safely"@en,
        "Fuite de gaz enflammé: Ne pas éteindre si la fuite ne peut pas être arrêtée sans danger"@fr,
        "In caso d’incendio dovuto a perdita di gas, non estinguere a meno che non sia possibile bloccare la perdita senza pericolo"@it .

ghs:P378 a ghs:GHSStatement,
