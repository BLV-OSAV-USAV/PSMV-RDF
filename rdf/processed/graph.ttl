    schema:identifier "14049" .

code:BAF8FB20-CB72-4DC7-814D-141D09BBD4B0 a :Obligation ;
    schema:description "Maximal 1 Behandlung in dieser Anwendung."@de,
        "1 traitement au maximum dans cette application."@fr,
        "Al massimo 1 trattamento in questa applicazione."@it ;
    schema:identifier "15449" .

code:BB0A0558-E1A3-42D0-BB52-AEDD1102A4B0 a :Obligation ;
    schema:description "Beizen des Saatguts: Schutzhandschuhe + Schutzanzug + Schutzbrille tragen"@de,
