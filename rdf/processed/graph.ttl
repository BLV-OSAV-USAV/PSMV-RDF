    schema:identifier "P301+P310" ;
    schema:name "BEI VERSCHLUCKEN: Sofort GIFTINFORMATIONSZENTRUM/Arzt/…/anrufen"@de,
        "IF SWALLOWED: Immediately call a POISON CENTER/doctor/…"@en,
        "EN CAS D’INGESTION: Appeler immédiatement un CENTRE ANTIPOISON/un médecin/…"@fr,
        "IN CASO DI INGESTIONE: contattare immediatamente un CENTRO ANTIVELENI/un medico/…"@it .

ghs:P301P312 a _:nb5f359406d5140309af48feb0a7206e9b1,
