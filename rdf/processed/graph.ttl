        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P362,
        ghs:P364 ;
    schema:identifier "P362+P364" ;
    schema:name "Kontaminierte Kleidung ausziehen und vor erneutem Tragen waschen"@de,
        "Take off contaminated clothing and wash it before reuse"@en,
        "Enlever les vêtements contaminés et les laver avant réutilisation"@fr,
        "Togliere tutti gli indumenti contaminati e lavarli prima di indossarli nuovamente"@it .

ghs:P363 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P363" ;
    schema:name "Kontaminierte Kleidung vor erneutem Tragen waschen"@de,
        "Wash contaminated clothing before reuse"@en,
        "Laver les vêtements contaminés avant réutilisation"@fr,
        "Lavare gli indumenti contaminati prima di indossarli nuovamente"@it .

ghs:P364 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P364" ;
    schema:name "Und vor erneutem Tragen waschen"@de,
        "And wash it before reuse"@en,
        "Et les laver avant réutilisation"@fr,
        "E lavarli prima di indossarli nuovamente"@it .

ghs:P370 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P370" ;
    schema:name "Bei Brand:"@de,
        "In case of fire:"@en,
        "En cas d’incendie:"@fr,
        "In caso di incendio:"@it .

ghs:P370P372P380P373 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P370,
        ghs:P372,
        ghs:P373,
        ghs:P380 ;
    schema:identifier "P370+P372+P380+P373" ;
    schema:name "Bei Brand: Explosionsgefahr. Umgebung räumen. KEINE Brandbekämpfung, wenn das Feuer explosive Stoffe/Gemische/Erzeugnisse erreicht"@de,
        "In case of fire: Explosion risk. Evacuate area. DO NOT fight fire when fire reaches explosives"@en,
        "En cas d'incendie: Risque d'explosion. Évacuer la zone. NE PAS combattre l'incendie lorsque le feu atteint les explosifs"@fr,
        "Rischio di esplosione in caso di incendio. Evacuare la zona. NON utilizzare mezzi estinguenti se l'incendio raggiunge materiali esplosivi"@it .

ghs:P370P376 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P370,
        ghs:P376 ;
    schema:identifier "P370+P376" ;
    schema:name "Bei Brand: Undichtigkeit beseitigen, wenn gefahrlos möglich"@de,
        "In case of fire: Stop leak if safe to do so"@en,
        "En cas d’incendie: obturer la fuite si cela peut se faire sans danger"@fr,
        "In caso di incendio: bloccare la perdita se non c’è pericolo"@it .

ghs:P370P378 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P370,
        ghs:P378 ;
    schema:identifier "P370+P378" ;
    schema:name "Bei Brand: … zum Löschen verwenden"@de,
        "In case of fire: Use… to extinguish"@en,
        "En cas d’incendie: Utiliser… pour l’extinction"@fr,
        "In caso d’incendio: utilizzare…per estinguere"@it .

ghs:P370P380P375 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P370,
        ghs:P375,
        ghs:P380 ;
    schema:identifier "P370+P380+P375" ;
    schema:name "Bei Brand: Umgebung räumen. Wegen Explosionsgefahr Brand aus der Entfernung bekämpfen"@de,
        "In case of fire: Evacuate area. Fight fire remotely due to the risk of explosion"@en,
        "En cas d’incendie: évacuer la zone. Combattre l’incendie à distance à cause du risque d'explosion"@fr,
        "In caso di incendio: evacuare la zona. Rischio di esplosione. Utilizzare i mezzi estinguenti a grande distanza"@it .

ghs:P370P380P375P378 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P370,
        ghs:P375,
        ghs:P378,
