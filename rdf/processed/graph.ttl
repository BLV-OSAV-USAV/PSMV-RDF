    schema:identifier "P372" ;
    schema:name "Explosionsgefahr"@de,
        "Explosion risk"@en,
        "Risque d'explosion"@fr,
        "Rischio di esplosione"@it .

ghs:P373 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P373" ;
    schema:name "KEINE Brandbekämpfung, wenn das Feuer explosive Stoffe/Gemische/Erzeugnisse erreicht"@de,
