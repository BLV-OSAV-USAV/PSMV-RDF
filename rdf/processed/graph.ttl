    schema:identifier "8780" .

code:200FF561-CBB3-4A9C-8F4D-45F8C16DB01B a :Obligation ;
    schema:description "Maximal 9 Behandlungen pro Kultur."@de,
        "9 traitements au maximum par culture."@fr,
        "Al massimo 9 trattamenti per coltura."@it ;
    schema:identifier "15484" .

code:2010BC8B-5236-4375-B635-D3A9DECCEC65 a :Obligation ;
