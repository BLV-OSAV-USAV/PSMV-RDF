        "Stocker dans un endroit bien ventilé. Tenir au frais"@fr,
        "Conservare in luogo fresco e ben ventilato"@it .

ghs:P404 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P404" ;
    schema:name "In einem geschlossenen Behälter aufbewahren"@de,
        "Store in a closed container"@en,
        "Stocker dans un récipient fermé"@fr,
        "Conservare in un recipiente chiuso"@it .

ghs:P405 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P405" ;
    schema:name "Unter Verschluss aufbewahren"@de,
        "Store locked up"@en,
        "Garder sous clef"@fr,
        "Conservare sotto chiave"@it .

ghs:P406 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P406" ;
    schema:name "In korrosionsbeständigem/… Behälter mit korrosionsbeständiger Innenauskleidung aufbewahren"@de,
        "Store in a corrosion-resistant/… container with a resistant inner liner"@en,
        "Stocker dans un récipient résistant à la corrosion/… avec doublure intérieure"@fr,
        "Conservare in recipiente resistente alla corrosione/… provvisto di rivestimento interno resistente"@it .

ghs:P407 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P407" ;
    schema:name "Luftspalt zwischen Stapeln oder Paletten lassen"@de,
        "Maintain air gap between stacks or pallets"@en,
        "Maintenir un intervalle d'air entre les piles ou les palettes"@fr,
        "Mantenere uno spazio libero tra gli scaffali o i pallet"@it .

ghs:P410 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P410" ;
    schema:name "Vor Sonnenbestrahlung schützen"@de,
        "Protect from sunlight"@en,
        "Protéger du rayonnement solaire"@fr,
        "Proteggere dai raggi solari"@it .

ghs:P410P403 a ghs:GHSStatement,
