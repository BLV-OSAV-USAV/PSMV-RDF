    schema:hasPart ghs:P410,
        ghs:P412 ;
    schema:identifier "P410+P412" ;
    schema:name "Vor Sonnenbestrahlung schützen und nicht Temperaturen über 50 °C/122 °F aussetzen"@de,
        "Protect from sunlight. Do no expose to temperatures exceeding 50 °C/122 °F"@en,
        "Protéger du rayonnement solaire. Ne pas exposer à une température supérieure à 50 °C/122 °F"@fr,
        "Proteggere dai raggi solari. Non esporre a temperature superiori a 50 °C/122 °F"@it .

ghs:P411 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P411" ;
    schema:name "Bei Temperaturen nicht über … °C/… °F aufbewahren"@de,
        "Store at temperatures not exceeding … °C/… °F"@en,
        "Stocker à une température ne dépassant pas … °C/… °F"@fr,
        "Conservare a temperature non superiori a … °C/… °F"@it .

ghs:P412 a ghs:GHSStatement,
