    schema:identifier "P391" ;
    schema:name "Verschüttete Mengen aufnehmen"@de,
        "Collect spillage"@en,
        "Recueillir le produit répandu"@fr,
        "Raccogliere il materiale fuoriuscito"@it .

ghs:P401 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P401" ;
    schema:name "Aufbewahren gemäß …"@de,
        "Store in accordance with…"@en,
        "Stocker conformément à…"@fr,
        "Conservare secondo…"@it .

ghs:P402 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P402" ;
    schema:name "An einem trockenen Ort aufbewahren"@de,
        "Store in a dry place"@en,
        "Stocker dans un endroit sec"@fr,
        "Conservare in luogo asciutto"@it .

