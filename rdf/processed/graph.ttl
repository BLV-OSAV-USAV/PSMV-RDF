        "EN CAS DE CONTACT AVEC LA PEAU (ou les cheveux):"@fr,
        "IN CASO DI CONTATTO CON LA PELLE (o con i capelli):"@it .

ghs:P303P361P353 a _:nb5d4b645a8d94404ba4f47a2b145e43cb1,
