    schema:identifier "8310" .

code:1E37C55D-5271-4F64-A51D-1414E957425A a :Obligation ;
    schema:description "Bei der Anwendung des Mittels mindestens Schutzhandschuhe + langärmliges Hemd + lange Hose tragen."@de,
