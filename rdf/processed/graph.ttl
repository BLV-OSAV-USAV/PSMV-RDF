        "Applicare solo durante il riposo vegetativo a fine inverno."@it ;
    schema:identifier "15691" .

code:99D47C76-E5B3-4EAD-9979-1E9A7870BE5E a :Obligation ;
    schema:description "Aufwandmenge berechnet auf max. 4m Lagertiefe."@de,
