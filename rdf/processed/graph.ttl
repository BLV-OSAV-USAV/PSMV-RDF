code:48C0323F-FC5A-4BDE-99EE-BFE5FA478B21 a :Obligation ;
    schema:description "Nur in Tankmischung mit 0.1% Folpet 80%."@de,
        "Uniquement en mélange avec 0.1% de Folpet 80%."@fr,
