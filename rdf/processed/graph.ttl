        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P317,
        ghs:P337 ;
    schema:identifier "P337+P317" ;
    schema:name "Obtain, read and follow all safety instructions before use"@en .

ghs:P338 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P338" ;
    schema:name "Eventuell Vorhandene Kontaktlinsen nach Möglichkeit entfernen. Weiter ausspülen"@de,
        "Remove contact lenses, if present and easy to do. Continue rinsing"@en,
        "Enlever les lentilles de contact si la victime en porte et si elles peuvent être facilement enlevées. Continuer à rincer"@fr,
        "Togliere le eventuali lenti a contatto se è agevole farlo. Continuare a sciacquare"@it .

ghs:P340 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P340" ;
    schema:name "Die Person an die frische Luft bringen und für ungehinderte Atmung sorgen"@de,
        "Remove person to fresh air and keep comfortable for breathing"@en,
        "Transporter la personne à l’extérieur et la maintenir dans une position où elle peut confortablement respirer"@fr,
        "Trasportare l’infortunato all’aria aperta e mantenerlo a riposo in posizione che favorisca la respirazione"@it .

ghs:P342 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P342" ;
    schema:name "Bei Symptomen der Atemwege:"@de,
        "If experiencing respiratory symptoms:"@en,
        "En cas de symptômes respiratoires:"@fr,
        "In caso di sintomi respiratori:"@it .

ghs:P342P311 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P311,
        ghs:P342 ;
    schema:identifier "P342+P311" ;
    schema:name "Bei Symptomen der Atemwege: GIFTINFORMATIONSZENTRUM/Arzt/…/anrufen"@de,
        "If experiencing respiratory symptoms: Call a POISON CENTER/doctor/…"@en,
        "En cas de symptômes respiratoires: Appeler un CENTRE ANTIPOISON/un médecin/…"@fr,
        "In caso di sintomi respiratori: contattare un CENTRO ANTIVELENI/un medico/…"@it .

ghs:P342P316 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P316,
        ghs:P342 ;
    schema:identifier "P342+P316" ;
    schema:name "Obtain, read and follow all safety instructions before use"@en .

ghs:P351 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P351" ;
    schema:name "Einige Minuten lang behutsam mit Wasser ausspülen"@de,
        "Rinse cautiously with water for several minutes"@en,
        "Rincer avec précaution à l’eau pendant plusieurs minutes"@fr,
        "Sciacquare accuratamente per parecchi minuti"@it .

ghs:P352 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P352" ;
    schema:name "Mit viel Wasser/…/waschen"@de,
        "Wash with plenty of water/…"@en,
        "Laver abondamment à l’eau/…"@fr,
        "Lavare abbondantemente con acqua/…"@it .

ghs:P353 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P353" ;
    schema:name "Haut mit Wasser abwaschen [oder duschen]"@de,
        "Rinse skin with water [or shower]"@en,
        "Rincer la peau à l'eau [ou se doucher]"@fr,
        "Sciacquare la pelle [o fare una doccia]"@it .

ghs:P360 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P360" ;
    schema:name "Kontaminierte Kleidung und Haut sofort mit viel Wasser abwaschen und danach Kleidung ausziehen"@de,
        "Rinse immediately contaminated clothing and skin with plenty of water before removing clothes"@en,
        "Rincer immédiatement et abondamment avec de l’eau les vêtements contaminés et la peau avant de les enlever"@fr,
        "Sciacquare immediatamente e abbondantemente gli indumenti contaminati e la pelle prima di togliersi gli indumenti"@it .

ghs:P361 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P361" ;
    schema:name "Alle kontaminierten Kleidungsstücke sofort ausziehen"@de,
        "Take off immediately all contaminated clothing"@en,
        "Enlever immédiatement tous les vêtements contaminés"@fr,
        "Togliere immediatamente tutti gli indumenti contaminati"@it .

ghs:P361P364 a ghs:GHSStatement,
        ghs:PrecautionaryStatement,
        ghs:PrecautionaryStatementCombination ;
    schema:hasPart ghs:P361,
        ghs:P364 ;
    schema:identifier "P361+P364" ;
    schema:name "Alle kontaminierten Kleidungsstücke sofort ausziehen und vor erneutem Tragen waschen"@de,
        "Take off immediately all contaminated clothing and wash it before reuse"@en,
        "Enlever immédiatement tous les vêtements contaminés et les laver avant réutilisation"@fr,
        "Togliere immediatamente tutti gli indumenti contaminati e lavarli prima di indossarli nuovamente"@it .

ghs:P362 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P362" ;
    schema:name "Kontaminierte Kleidung ausziehen"@de,
        "Take off contaminated clothing"@en,
        "Enlever les vêtements contaminés"@fr,
        "Togliere gli indumenti contaminati"@it .

ghs:P362P364 a ghs:GHSStatement,
