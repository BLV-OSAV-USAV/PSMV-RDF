ghs:P381 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P381" ;
    schema:name "Bei Undichtigkeit alle Zündquellen entfernen"@de,
        "In case of leakage, eliminate all ignition sources"@en,
        "En cas de fuite, éliminer toutes les sources d'ignition"@fr,
        "In caso di perdita, eliminare ogni fonte di accensione"@it .

ghs:P390 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P390" ;
    schema:name "Verschüttete Mengen aufnehmen, um Materialschäden zu vermeiden"@de,
        "Absorb spillage to prevent material damage"@en,
        "Absorber toute substance répandue pour éviter qu’elle attaque les matériaux environnants"@fr,
        "Assorbire la fuoriuscita per evitare danni materiali"@it .

ghs:P391 a ghs:GHSStatement,
