:productType rdfs:subPropertyOf rdf:type .

shape:identifier sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Identifikator"@de,
        "Identifier"@en ;
    sh:order 1 ;
    sh:path schema:identifier .

shape:multiLanguageDescription sh:datatype rdf:langString ;
    sh:description "Multilingual description. German ('de') and French ('fr') translations are mandatory. Italian ('it') and English ('en') are optional. Only one entry per language is allowed, and no other languages are permitted."@en ;
    sh:languageIn ( "de" "fr" "it" "en" ) ;
    sh:maxCount 4 ;
    sh:minCount 2 ;
    sh:name "Beschreibung"@de,
        "Description"@en ;
    sh:order 2 ;
    sh:path schema:description ;
    sh:qualifiedMinCount 2 ;
    sh:qualifiedValueShape [ sh:languageIn ( "de" "fr" ) ] ;
    sh:uniqueLang true .

schema:legalName rdfs:subPropertyOf schema:name .

shape:multiLanguageName sh:datatype rdf:langString ;
    sh:description "Multilingual name. German ('de') and French ('fr') translations are mandatory. Italian ('it') and English ('en') are optional. Only one entry per language is allowed, and no other languages are permitted."@en ;
    sh:languageIn ( "de" "fr" "it" "en" ) ;
    sh:maxCount 4 ;
    sh:minCount 2 ;
    sh:name "Name"@en ;
    sh:order 2 ;
    sh:path schema:name ;
    sh:qualifiedMinCount 2 ;
    sh:qualifiedValueShape [ sh:languageIn ( "de" "fr" ) ] ;
    sh:uniqueLang true .

