        "Mantenere uno spazio libero tra gli scaffali o i pallet"@it .

ghs:P410 a ghs:GHSStatement,
        ghs:PrecautionaryStatement ;
    schema:identifier "P410" ;
    schema:name "Vor Sonnenbestrahlung schützen"@de,
        "Protect from sunlight"@en,
        "Protéger du rayonnement solaire"@fr,
        "Proteggere dai raggi solari"@it .

ghs:P410P403 a ghs:GHSStatement,
